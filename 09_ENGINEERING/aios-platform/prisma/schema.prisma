  m14AuditEntries      M14AuditEntry[]

  m25ReviewCreated  M25ContextReview[]   @relation("M25ReviewCreated")
  m25ReviewReviewed M25ContextReview[]   @relation("M25ReviewReviewed")
  m25ReviewApproved M25ContextReview[]   @relation("M25ReviewApproved")
  m25IssueOwned     M25ContextIssue[]    @relation("M25IssueOwner")
  m25PartyOwned     M25InterestedParty[] @relation("M25PartyOwner")
  m25AuditEntries   M25AuditEntry[]

  m26ItemCreated      M26KnowledgeItem[]      @relation("M26ItemCreated")
  m26ItemReviewed     M26KnowledgeItem[]      @relation("M26ItemReviewed")
  m26ItemApproved     M26KnowledgeItem[]      @relation("M26ItemApproved")
  m26ItemOwned        M26KnowledgeItem[]      @relation("M26ItemOwner")
  m26Holders          M26KnowledgeHolder[]
  m26LessonCreated    M26LessonLearned[]      @relation("M26LessonCreated")
  m26LessonApproved   M26LessonLearned[]      @relation("M26LessonApproved")
  m26NeedCreated      M26KnowledgeNeed[]      @relation("M26NeedCreated")
  m26NeedResponsible  M26KnowledgeNeed[]      @relation("M26NeedResponsible")
  m26NeedDecided      M26KnowledgeNeed[]      @relation("M26NeedDecided")
  m26SharingCreated   M26SharingEvent[]       @relation("M26SharingCreated")
  m26SharingPresented M26SharingEvent[]       @relation("M26SharingPresenter")
  m26Participations   M26SharingParticipant[]
  m26AuditEntries     M26AuditEntry[]

  accessRequestsReviewed AccessRequest[] @relation("AccessRequestReviewer")

  copilotThreads CopilotThread[]

  m34DataSetCreated      M34DataSet[]            @relation("M34DataSetCreated")
  m34DataSetOwned        M34DataSet[]            @relation("M34DataSetOwned")
  m34DataSetSteward      M34DataSet[]            @relation("M34DataSetSteward")
  m34DataSetApproved     M34DataSet[]            @relation("M34DataSetApproved")
  m34QualityMeasured     M34QualityMeasurement[] @relation("M34QualityMeasured")
  m34CorrectionRequested M34DataCorrection[]     @relation("M34CorrectionRequested")
  m34SharingRequested    M34SharingRequest[]     @relation("M34SharingRequested")
  m34SharingApproved     M34SharingRequest[]     @relation("M34SharingApproved")
  m34AIApproved          M34AIDataApproval[]     @relation("M34AIApproved")
  m34AuditEntries        M34AuditEntry[]
