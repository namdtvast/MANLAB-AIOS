enum M17PlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum M17ActionStatus {
  DANG_THUC_HIEN
  HOAN_THANH
}

enum M17ItemType {
  PLAN
  MINUTES
  ACTION
}

model M17ReviewPlan {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "CTXX-2026-0001"

  title         String
  isAdHoc       Boolean       @default(false)
  plannedDate   DateTime
  location      String
  attendees     String[]
  plannedTopics Int[] // chỉ số 1-12 theo mục 2.4 DacTa
  status        M17PlanStatus @default(DRAFT)
  reason        String?

  createdById     String
  tpApprovedById  String?
  tpApprovedAt    DateTime?
  ldvApprovedById String?
  ldvApprovedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy     User  @relation("M17PlanCreated", fields: [createdById], references: [id])
  tpApprovedBy  User? @relation("M17PlanTpApproved", fields: [tpApprovedById], references: [id])
  ldvApprovedBy User? @relation("M17PlanLdvApproved", fields: [ldvApprovedById], references: [id])

  minutes M17ReviewMinutes[]
}

model M17ReviewMinutes {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "BBXX-2026-0001"

  planId       String
  meetingDate  DateTime
  topicResults Json // mảng 12 phần tử {topicId, assessmentResult}
  conclusion   String? // chỉ LĐV ghi được, qua action riêng

  recordedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan       M17ReviewPlan @relation(fields: [planId], references: [id])
  recordedBy User          @relation("M17MinutesRecorded", fields: [recordedById], references: [id])

  actions M17ReviewActionTracking[]
  capas   M17CorrectiveActionRequest[]
