  m14DocCreated        M14Document[]             @relation("M14DocCreated")
  m14DocReviewed       M14Document[]             @relation("M14DocReviewed")
  m14DocApproved       M14Document[]             @relation("M14DocApproved")
  m14DocPublished      M14Document[]             @relation("M14DocPublished")
  m14Suggestions       M14AiSuggestion[]         @relation("M14SuggestionCreated")
