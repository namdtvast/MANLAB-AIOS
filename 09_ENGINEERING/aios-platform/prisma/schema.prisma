  signedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee M03Employee @relation(fields: [employeeId], references: [id])
  signedBy User?       @relation("M03ContractSigned", fields: [signedById], references: [id])
