enum M25ItemType {
  REVIEW
  ISSUE
  PARTY
  EXPECTATION
}

model M25ContextReview {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "BC-2026-0001"

  cycleType     M25CycleType
  periodYear    Int
  triggerReason String? // bắt buộc khi DOT_XUAT (quy tắc 2 — kiểm ở rules.ts)
  scopeSystems  M25MgmtSystem[]
  summary       String?
  conclusion    String? // chỉ LĐV ghi khi phê duyệt
  status        M25ReviewStatus @default(DRAFT)
  reason        String? // lý do trả lại/hủy gần nhất

  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  approvedById String?
  approvedAt   DateTime?

  supersedesId String? @unique // kỳ liền trước bị kỳ này thay thế

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy  User  @relation("M25ReviewCreated", fields: [createdById], references: [id])
  reviewedBy User? @relation("M25ReviewReviewed", fields: [reviewedById], references: [id])
  approvedBy User? @relation("M25ReviewApproved", fields: [approvedById], references: [id])

  supersedes   M25ContextReview? @relation("M25Supersede", fields: [supersedesId], references: [id])
  supersededBy M25ContextReview? @relation("M25Supersede")

  issues  M25ContextIssue[]
  parties M25InterestedParty[]
}

model M25ContextIssue {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "VD-2026-0001"

  reviewId    String
  origin      M25IssueOrigin
  category    M25IssueCategory
  title       String
  description String
  direction   M25Direction

  affectedSystems     M25MgmtSystem[]
  impactLevel         M25ImpactLevel
  monitoringMethod    String
  monitoringFrequency M25MonitorFreq

  ownerId       String?
  objectiveRefs String[] // → M24 (chưa xây) — giữ dạng chuỗi cho tới khi M24 lên nền tảng
  evidenceRefs  String[] // văn bản pháp luật (08), phản hồi (M12), KPH (M16)…

  status      M25EntryStatus @default(CON_HIEU_LUC)
  closeReason String? // bắt buộc khi DA_DONG (quy tắc 10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // dùng làm "lần cập nhật gần nhất" khi tính đến hạn xem xét

  review M25ContextReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  owner  User?            @relation("M25IssueOwner", fields: [ownerId], references: [id])

  riskLinks M25IssueRiskLink[]
}

// Liên kết vấn đề bối cảnh → rủi ro/cơ hội bên M01 (quy tắc 3: vấn đề mức CAO bắt buộc có ≥1).
// FK thật sang M01 vì M01 đã ACTIVE trên nền tảng — không lưu chuỗi tự do.
model M25IssueRiskLink {
  id      String @id @default(cuid())
  issueId String

  riskId        String? // đúng 1 trong 2 — kiểm ở rules.ts
  opportunityId String?

  createdAt DateTime @default(now())

  issue       M25ContextIssue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  risk        M01RiskItem?        @relation("M25LinkRisk", fields: [riskId], references: [id])
  opportunity M01OpportunityItem? @relation("M25LinkOpp", fields: [opportunityId], references: [id])

  @@unique([issueId, riskId])
  @@unique([issueId, opportunityId])
}

model M25InterestedParty {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "BQT-2026-0001"

  reviewId            String
  name                String
  group               M25PartyGroup
  influenceLevel      M25InfluenceLevel
  engagementChannel   String
  monitoringFrequency M25MonitorFreq

  ownerId String?

  // ISO/IEC 17025 §4.1 — quan hệ có nguy cơ ảnh hưởng tính khách quan (quy tắc 5: nhắc, không chặn)
  impartialityFlag Boolean @default(false)

  status      M25EntryStatus @default(CON_HIEU_LUC)
  closeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review M25ContextReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  owner  User?            @relation("M25PartyOwner", fields: [ownerId], references: [id])

  expectations M25PartyExpectation[]
}

model M25PartyExpectation {
  id      String @id @default(cuid())
  partyId String

  description            String
  source                 M25ExpectationSource
  isComplianceObligation Boolean              @default(false)
  obligationRef          String? // bắt buộc khi isComplianceObligation (quy tắc 4)
  responseAction         String
  responseModuleRef      String?
  fulfillmentStatus      M25FulfillmentStatus @default(DANG_DAP_UNG)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party M25InterestedParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model M25AuditEntry {
  id       String      @id @default(cuid())
  itemType M25ItemType
  itemId   String
  ts       DateTime    @default(now())
  actorId  String
  role     String
  action   String
  reason   String?

  actor User @relation(fields: [actorId], references: [id])
}

// ---------- M26 — Quản lý tri thức tổ chức ----------
// Nguồn: Thủ tục ETV.P26 (ban hành lần 01, 23/08/2026) + 05_MODULE_LIBRARY/M26_TriThuc/01_Requirement/DacTa.md.
// Nguyên tắc: SỔ ĐĂNG KÝ, không phải kho nội dung — chỉ metadata + đường dẫn tới nội dung gốc
// (08_KNOWLEDGE_GRAPH, M14, M15, M05). Xem quy tắc 1 DacTa M26 / ETV.P26 mục 1.3.

enum M26KnowledgeForm {
  TRI_THUC_HIEN // đã văn bản hóa — bắt buộc sourceRef hoặc docId
  TRI_THUC_AN // nằm ở con người — bắt buộc ≥ 1 người giữ
}

enum M26Category {
  PHAP_LY_TIEU_CHUAN
  KY_THUAT_DO_LUONG
  VAN_HANH_THIET_BI
  BAI_HOC_TINH_HUONG
  HE_THONG_QUAN_LY
  KHACH_HANG_DICH_VU
  SO_HOA_DU_LIEU_AI
  NGHIEN_CUU_PHAT_TRIEN
}

enum M26Origin {
  NOI_BO
  BEN_NGOAI
}

enum M26Criticality {
  THAP
  TRUNG_BINH
  CAO
}

// Thang phân loại bảo mật KẾ THỪA của ETV.MP02/MP27/MP28 — M26 không định nghĩa thang riêng
// (quy tắc 9 DacTa M26 / ETV.P26 mục 5.1.4).
enum M26Confidentiality {
  CONG_KHAI
  NOI_BO
  HAN_CHE
  MAT
}

enum M26ReviewCycle {
  SAU_THANG
  NAM
  HAI_NAM
  THEO_SU_KIEN
}

enum M26ItemStatus {
  DRAFT
  PENDING_REVIEW
  REVIEW_REJECTED
  PENDING_APPROVAL
  APPROVAL_REJECTED
  APPROVED
  RETIRED // hết hiệu lực — tự gỡ khỏi chỉ mục AI
  CANCELLED
}

enum M26LessonSource {
  KPH_CAPA // ← M13
  KHIEU_NAI // ← M12
  KET_QUA_NGOAI_KIEM_SOAT // ← M10
  DANH_GIA // ← M16
  SU_CO_THIET_BI // ← M05
  SU_CO_ATTT // ← M28
  SU_CO_AI // ← M29
  HOP_DONG_DU_AN // ← M07
  NGHIEN_CUU
}

enum M26LessonStatus {
  MOI
  DANG_PHAN_TICH
  CHO_PHE_DUYET
  DA_PHE_DUYET
  HUY
}

enum M26NeedTrigger {
  PHUONG_PHAP_MOI
  THIET_BI_MOI
  MO_RONG_PHAM_VI
  BIEN_DONG_NHAN_SU
  CONG_NGHE_AI_MOI
  THAY_DOI_PHAP_LUAT
  VAN_DE_BOI_CANH
  KPH_LAP_LAI
  CHUYEN_GIAO_TRI_THUC_AN // phát sinh từ gate quy tắc 3
}

enum M26NeedMethod {
  DAO_TAO_NOI_BO
  DAO_TAO_BEN_NGOAI
  TUYEN_DUNG
  THUE_CHUYEN_GIA
  MUA_TAI_LIEU
  NGHIEN_CUU_NOI_BO
  HOP_TAC_CHUYEN_GIAO
  KEM_CAP
  VAN_BAN_HOA
}

enum M26NeedStatus {
  MO
  DANG_BO_SUNG
  DA_DAP_UNG
  KHONG_THUC_HIEN
}

enum M26SharingForm {
  SINH_HOAT_CHUYEN_MON
  DAO_TAO_NOI_BO
  KEM_CAP
  BAN_TIN_FAQ
  PHO_BIEN_HOI_THAO
  BAN_GIAO_NHAN_SU
}

enum M26SharingStatus {
  KE_HOACH
  DA_THUC_HIEN
  HUY
}

enum M26ItemType {
  ITEM
  LESSON
  NEED
  SHARING
}

model M26KnowledgeItem {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "TT-2026-0001"

  title         String
  knowledgeForm M26KnowledgeForm
  category      M26Category
  origin        M26Origin
  summary       String // tóm tắt để tìm kiếm — GIỚI HẠN ĐỘ DÀI ở rules.ts, cấm dán toàn văn (quy tắc 1)

  sourceRef String? // đường dẫn nội dung gốc: 08_KNOWLEDGE_GRAPH/..., M15, M05
  docId     String? // → M14Document khi tri thức là tài liệu kiểm soát (quy tắc 2)

  ownerId         String
  criticality     M26Criticality
  confidentiality M26Confidentiality
  appliesTo       String[] // phương pháp/thiết bị/dịch vụ áp dụng — chuỗi tham chiếu cho tới khi M08/M05 mở API
  reviewCycle     M26ReviewCycle
  lastReviewedAt  DateTime? // mốc tính cờ "đến hạn rà soát" (tính khi đọc — quy tắc 4)

  aiIndexed Boolean @default(false) // chỉ bật khi APPROVED và bảo mật ∈ {CONG_KHAI, NOI_BO} (quy tắc 10)

  version      Int     @default(1)
  supersedesId String? @unique // phiên bản bị thay thế (quy tắc 5)

  status M26ItemStatus @default(DRAFT)
  reason String? // lý do trả lại/hết hiệu lực/hủy gần nhất

  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  approvedById String?
  approvedAt   DateTime?
  retiredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User         @relation("M26ItemOwner", fields: [ownerId], references: [id])
  createdBy  User         @relation("M26ItemCreated", fields: [createdById], references: [id])
  reviewedBy User?        @relation("M26ItemReviewed", fields: [reviewedById], references: [id])
  approvedBy User?        @relation("M26ItemApproved", fields: [approvedById], references: [id])
  document   M14Document? @relation(fields: [docId], references: [id])

  supersedes   M26KnowledgeItem? @relation("M26Supersede", fields: [supersedesId], references: [id])
  supersededBy M26KnowledgeItem? @relation("M26Supersede")

  holders    M26KnowledgeHolder[]
  riskLinks  M26ItemRiskLink[]
  lessons    M26LessonLearned[]
  needs      M26KnowledgeNeed[]   @relation("M26NeedResultItem") // nhu cầu có KẾT QUẢ là mục này
  targetedBy M26KnowledgeNeed[]   @relation("M26NeedTargetItem") // nhu cầu nhằm bổ sung/chuyển giao CHÍNH mục này
  sharings   M26SharingItem[]
}

// Người đang giữ tri thức ẩn. Tri thức ẩn + trọng yếu CAO + đúng 1 người ⇒ chặn phê duyệt
// tới khi có riskLinks và nhu cầu chuyển giao (quy tắc 3 / ETV.P26 mục 5.1.6).
model M26KnowledgeHolder {
  id     String  @id @default(cuid())
  itemId String
  userId String
  note   String?

  createdAt DateTime @default(now())

  item M26KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id])

  @@unique([itemId, userId])
}

// Liên kết mục tri thức → rủi ro bên M01. FK thật vì M01 đã ACTIVE (NFR truy vết chéo).
model M26ItemRiskLink {
  id     String @id @default(cuid())
  itemId String
  riskId String

  createdAt DateTime @default(now())

  item M26KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  risk M01RiskItem      @relation(fields: [riskId], references: [id])

  @@unique([itemId, riskId])
}

model M26LessonLearned {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "BH-2026-0001"

  title      String
  sourceType M26LessonSource
  sourceRef  String // mã bản ghi gốc ở module nguồn (quy tắc 6)
  m13NcId    String? // FK thật khi nguồn là KPH của M13 (hook mềm — increment sau)

  context           String
  rootCauseRef      String? // → M13, không phân tích lại nguyên nhân gốc
  lesson            String
  recommendedAction String

  knowledgeItemId String? // bắt buộc trước khi phê duyệt (quy tắc 7)
  shareRequired   Boolean @default(false)

  status M26LessonStatus @default(MOI)
  reason String?

  createdById  String
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy     User                  @relation("M26LessonCreated", fields: [createdById], references: [id])
  approvedBy    User?                 @relation("M26LessonApproved", fields: [approvedById], references: [id])
  knowledgeItem M26KnowledgeItem?     @relation(fields: [knowledgeItemId], references: [id])
  m13Nc         M13NonconformingWork? @relation(fields: [m13NcId], references: [id])
}

model M26KnowledgeNeed {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "NC-2026-0001"

  trigger     M26NeedTrigger
  triggerRef  String // bản ghi/căn cứ làm phát sinh nhu cầu
  description String
  requiredBy  DateTime
  method      M26NeedMethod

  responsibleId String

  // Mục tri thức mà nhu cầu này nhằm bổ sung/chuyển giao — ĐẦU VÀO, khác với kết quả bên dưới.
  // Dùng cho gate ETV.P26 mục 5.1.6: mục tri thức ẩn trọng yếu 1 người giữ phải có phiếu chuyển giao.
  targetItemId String?

  // Đầu ra bắt buộc khi đóng ở trạng thái DA_DAP_UNG (quy tắc 8): mục tri thức mới HOẶC hồ sơ đào tạo M03.
  resultItemId     String?
  resultTrainingId String?

  status M26NeedStatus @default(MO)
  reason String? // bắt buộc khi KHONG_THUC_HIEN (LĐV duyệt)

  createdById String
  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy      User               @relation("M26NeedCreated", fields: [createdById], references: [id])
  responsible    User               @relation("M26NeedResponsible", fields: [responsibleId], references: [id])
  decidedBy      User?              @relation("M26NeedDecided", fields: [decidedById], references: [id])
  targetItem     M26KnowledgeItem?  @relation("M26NeedTargetItem", fields: [targetItemId], references: [id])
  resultItem     M26KnowledgeItem?  @relation("M26NeedResultItem", fields: [resultItemId], references: [id])
  resultTraining M03TrainingRecord? @relation("M26NeedTraining", fields: [resultTrainingId], references: [id])
}

model M26SharingEvent {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "CS-2026-0001"

  form   M26SharingForm
  heldAt DateTime
  topic  String

  presenterId String

  // Đào tạo nội bộ ⇒ hồ sơ chính thức ở M03 (F03.05.x), M26 chỉ trỏ — không lập biểu mẫu trùng (quy tắc 12).
  evidenceTrainingId String?
  evidenceRef        String?

  handoverNote      String? // dùng khi form = BAN_GIAO_NHAN_SU
  effectivenessNote String?

  status M26SharingStatus @default(KE_HOACH)
  reason String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy        User               @relation("M26SharingCreated", fields: [createdById], references: [id])
  presenter        User               @relation("M26SharingPresenter", fields: [presenterId], references: [id])
  evidenceTraining M03TrainingRecord? @relation("M26SharingTraining", fields: [evidenceTrainingId], references: [id])

  items        M26SharingItem[]
  participants M26SharingParticipant[]
}

// Chỉ được trỏ tới mục tri thức ở trạng thái APPROVED (quy tắc 12 — kiểm ở rules.ts).
model M26SharingItem {
  id      String @id @default(cuid())
  eventId String
  itemId  String

  event M26SharingEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item  M26KnowledgeItem @relation(fields: [itemId], references: [id])

  @@unique([eventId, itemId])
}

model M26SharingParticipant {
  id      String  @id @default(cuid())
  eventId String
  userId  String
  note    String?

  event M26SharingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

// Append-only: không có server action xóa/sửa. Ghi cả LƯỢT XEM mục HAN_CHE/MAT (ISO/IEC 27001,
// ETV.P26 mục 5.5) và giá trị trước → sau của mỗi chuyển trạng thái (AC14).
model M26AuditEntry {
  id       String      @id @default(cuid())
  itemType M26ItemType
  itemId   String
  ts       DateTime    @default(now())
  actorId  String
  role     String
  action   String
  before   String?
  after    String?
  reason   String?

  actor User @relation(fields: [actorId], references: [id])

  @@index([itemType, itemId])
}

// ---------- Yêu cầu cấp tài khoản (trang chủ công khai) ----------
// Form "Đăng ký" ngoài trang chủ CHỈ ghi nhận đề nghị, không tạo User và không cấp
// mật khẩu — tài khoản vẫn do Quản trị hệ thống cấp theo quy trình hiện hành. Xem
// _meta/specs/20260824-trang-chu-cong-khai/spec.md (quy tắc R1–R6).

enum AccessRequestStatus {
  PENDING // Chờ Quản trị hệ thống xử lý
  APPROVED // Đồng ý cấp tài khoản
  REJECTED // Từ chối — bắt buộc kèm lý do
}

model AccessRequest {
  id           String              @id @default(cuid())
  fullName     String
  email        String
  organization String
  phone        String?
  purpose      String // Lý do cần truy cập, phần việc dự kiến
  status       AccessRequestStatus @default(PENDING)

  reviewNote   String? // Ghi chú của QTHT; bắt buộc khi từ chối
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("AccessRequestReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tra cứu hàng chờ theo email (quy tắc R2 — mỗi email chỉ một yêu cầu đang chờ).
  @@index([email])
  @@index([status, createdAt])
}

// ---------- M34 — Quản lý dữ liệu số ----------
// Nguồn: Thủ tục ETV.P34 (DỰ THẢO lần BH 01, trạng thái Chờ soát xét, 25/08/2026) +
// 05_MODULE_LIBRARY/M34_DuLieuSo/01_Requirement/DacTa.md. Thủ tục CHƯA được phê duyệt —
// giá trị định lượng (kỳ đo, chu kỳ rà soát, 15 ngày khắc phục) là đề xuất; đổi khi
// phê duyệt theo MP14 thì sửa rules.ts theo (DacTa M34 mục 10 điểm 1).
// Nguyên tắc xuyên suốt: bản ghi chỉ MÔ TẢ tập dữ liệu, không chứa dữ liệu thật (R6);
// không có DELETE trên M34DataSet — tập đã hủy giữ bản ghi để truy vết (Phụ lục II.1).

// Thang phân loại thông tin dùng chung ETV.P02/P27/P28 — KHÔNG prefix M34 vì đây là
// thang toàn Viện; M27 dùng lại enum này khi lên nền tảng (NFR "thang dùng chung").
enum Classification {
  CONG_KHAI
  NOI_BO
  HAN_CHE
  MAT
}

enum M34DataGroup {
  DO_KY_THUAT // Dữ liệu đo và dữ liệu kỹ thuật
  HO_SO_NGHIEP_VU
  DU_LIEU_CHU
  QUAN_TRI
  HE_THONG_QUAN_LY
  CONG_BO
  TRI_TUE_NHAN_TAO
}

enum M34LifecycleStage {
  HOAT_DONG
  LUU_TRU
  DE_NGHI_HUY
}

enum M34DataSetStatus {
  DRAFT
  PENDING_REVIEW
  REVIEW_REJECTED
  PENDING_APPROVAL
  APPROVAL_REJECTED
  ACTIVE // Hiệu lực — giai đoạn Hoạt động
  ARCHIVED // Lưu trữ
  DISPOSAL_PROPOSED // Đề nghị hủy
  DISPOSED // Đã hủy — bản ghi danh mục vẫn giữ
  CANCELLED // Hủy bản ghi (khai báo sai/trùng, trước phê duyệt)
}

enum M34ReviewCycle {
  THANG_12
  THANG_06 // khi tập chứa dữ liệu cá nhân (R8)
}

enum M34DictStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum M34MasterStatus {
  DE_NGHI
  DA_CONG_NHAN
  THU_HOI
}

enum M34FindingStatus {
  MOI
  DANG_XU_LY
  DA_XU_LY
}

enum M34QualityDimension {
  CHINH_XAC
  DAY_DU
  NHAT_QUAN
  KIP_THOI
  DUY_NHAT
  HOP_LE
}

enum M34QualityStatus {
  MOI
  DANG_DO
  CO_KET_QUA
  DAT
  KHONG_DAT
}

// Năm tình huống xử lý dưới ngưỡng — ETV.P34 §6.4.4 (bảng mục 4.6 DacTa M34)
enum M34BelowThresholdCase {
  MOT_CHIEU_KHONG_ANH_HUONG
  HAI_KY_LIEN_TIEP
  ANH_HUONG_KET_QUA_DA_PHAT_HANH
  TU_TICH_HOP_DONG_BO
  DU_LIEU_CHU_TRUNG
}

enum M34Trend {
  CAI_THIEN
  GIU_NGUYEN
  XAU_DI
}

enum M34PublishedImpact {
  CHUA_DUNG_PHAT_HANH
  DA_DUNG_PHAT_HANH
}

enum M34ValidityConclusion {
  CON_HIEU_LUC
  THU_HOI_PHAT_HANH_LAI
}

enum M34CorrectionStatus {
  MOI
  DANG_XEM_XET
  CHO_KET_LUAN_P10_P11 // chặn cứng R12 — không có đường thẳng sang DA_HIEU_CHINH
  DA_HIEU_CHINH
  TU_CHOI
}

enum M34SharingType {
  NOI_BO_VUOT_QUYEN // CSHDL phê duyệt
  RA_NGOAI_VIEN // LĐV phê duyệt, PT.ATTT ý kiến bắt buộc
  DINH_KY_TU_DONG // chuyển thiết lập điểm tích hợp M37 — không đi luồng phiếu
}

enum M34SharingStatus {
  DRAFT
  CHO_Y_KIEN_ATTT
  CHO_PHE_DUYET
  DA_PHE_DUYET
  DA_THUC_HIEN
  DA_THU_HOI
  TU_CHOI
}

enum M34AIPurpose {
  DU_LIEU_NGU_CANH
  TAP_TRI_THUC
  DANH_GIA_MO_HINH
}

enum M34AIApprovalStatus {
  DE_NGHI
  DA_PHE_DUYET
  THU_HOI
}

enum M34ItemType {
  DATASET
  DICTIONARY
  MASTER
  FINDING
  QUALITY
  CORRECTION
  SHARING
  AI_APPROVAL
}

enum M34PartyType {
  ORGANIZATION
  PERSON
}

enum M34PartyStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_APPROVAL
  ACTIVE
  REVIEW_REJECTED
  APPROVAL_REJECTED
  ARCHIVED
}


model M34Party {
  id           String         @id @default(cuid())
  seq          Int            @default(autoincrement())
  code         String         @unique
  partyType    M34PartyType
  legalName    String
  shortName    String?
  taxId        String?
  legacyCode   String?
  address      String?
  ward         String?
  province     String?
  country      String         @default("Việt Nam")
  source       String?
  ownerId      String?
  status       M34PartyStatus @default(DRAFT)
  reason       String?
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy  User              @relation("M34PartyCreated", fields: [createdById], references: [id])
  reviewedBy User?             @relation("M34PartyReviewed", fields: [reviewedById], references: [id])
  approvedBy User?             @relation("M34PartyApproved", fields: [approvedById], references: [id])
  roles      M34PartyRole[]
  contacts   M34PartyContact[]

  @@index([legalName])
  @@index([taxId])
  @@index([status])
}

// Loại vai trò của chủ thể — MASTER DATA cấu hình được, KHÔNG hard-code thành enum.
// Căn cứ: 09_ENGINEERING/05_Database/MasterData_ChuThe_VaiTro.md mục 4.4.
// Thêm/bớt một vai trò là thêm/sửa MỘT DÒNG DỮ LIỆU, không phải một migration.
model M34PartyRoleType {
  code        String   @id // vd "CUSTOMER", "AUDITEE"
  nameVi      String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partyRoles M34PartyRole[]
}

model M34PartyRole {
  id           String    @id @default(cuid())
  partyId      String
  roleTypeCode String
  scopeNote    String?
  validFrom    DateTime?
  validTo      DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  party    M34Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  roleType M34PartyRoleType  @relation(fields: [roleTypeCode], references: [code])

  @@unique([partyId, roleTypeCode])
  @@index([roleTypeCode])
}

model M34PartyContact {
  id         String   @id @default(cuid())
  partyId    String
  fullName   String
  position   String?
  email      String?
  phone      String?
  isLegalRep Boolean  @default(false)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  party      M34Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model M34DataSet {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "DS-2026-0001" — không cấp lại, kể cả sau Hủy bản ghi

  name      String
  dataGroup M34DataGroup
  purpose   String

  // R1 — không có dữ liệu vô chủ: hai trường NOT NULL, chặn ngay khi tạo
  ownerId          String // CSHDL — vai trò theo tập dữ liệu (DacTa mục 10 điểm 2)
  stewardId        String // QTDL
  primaryEntererId String? // người nhập liệu chính (khai báo) — phục vụ gate R16

  platformRef String? // → M35 (chưa lên nền tảng — mã tham chiếu mềm)
  infraRef    String? // → M33 (chưa lên nền tảng)
  copiesNote  String?

  classification       Classification
  hasPersonalData      Boolean
  personalDataLegalRef String? // bắt buộc khi hasPersonalData (R2)

  qualityMetricsNote String? // chỉ số + ngưỡng + kỳ đo — bắt buộc trước phê duyệt (R4)

  lifecycleStage  M34LifecycleStage @default(HOAT_DONG)
  activeRetention String?
  retentionBasis  String // R5 — ETV.P15 / F14.06 / pháp luật chuyên ngành

  readScope           String?
  writeScope          String?
  externalSharingNote String?

  infoAssetRef    String? // → M27
  recordRef       String? // → M15
  integrationRefs String[] // → M37

  isMasterData       Boolean @default(false)
  dictionaryRequired Boolean // true với DO_KY_THUAT / DU_LIEU_CHU / CONG_BO (R3)
  lineageNote        String? // nguồn phát sinh + phiên bản quy tắc biến đổi (R20)

  aiUsageApproved Boolean @default(false) // có M34AIDataApproval đang DA_PHE_DUYET

  reviewCycle    M34ReviewCycle @default(THANG_12)
  lastReviewedAt DateTime?

  suspendedUse  Boolean @default(false) // cờ dừng sử dụng (R14/R15)
  suspendReason String?

  status       M34DataSetStatus @default(DRAFT)
  reason       String? // lý do trả lại/hủy/lưu trữ gần nhất
  mergedIntoId String? // R7 — bị đánh dấu trùng, gộp vào tập nào

  // Bốn điều kiện trước khi hủy — ETV.P34 §6.7.2 (R21)
  disposalRetentionExpired  Boolean @default(false)
  disposalNotBasis          Boolean @default(false)
  disposalNoDispute         Boolean @default(false)
  disposalNoDependent       Boolean @default(false)
  disposalAtttConfirmedById String? // PT.ATTT xác nhận phương pháp hủy — chữ ký thứ hai
  disposalRecordRef         String? // biên bản hủy ← M27

  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy  User  @relation("M34DataSetCreated", fields: [createdById], references: [id])
  owner      User  @relation("M34DataSetOwned", fields: [ownerId], references: [id])
  steward    User  @relation("M34DataSetSteward", fields: [stewardId], references: [id])
  approvedBy User? @relation("M34DataSetApproved", fields: [approvedById], references: [id])

  dictionaryVersions  M34DictionaryVersion[]
  masterSources       M34MasterDataSource[]
  qualityMeasurements M34QualityMeasurement[]
  corrections         M34DataCorrection[]
  sharingRequests     M34SharingRequest[]
  aiApprovals         M34AIDataApproval[]

  @@index([lifecycleStage, status])
  @@index([lastReviewedAt])
}

model M34DictionaryVersion {
  id            String        @id @default(cuid())
  dataSetId     String
  version       Int // 1, 2, … — phiên bản cũ giữ nguyên để truy vết
  effectiveDate DateTime?
  changeRef     String? // phiếu F30.02 ← M30 — bắt buộc từ version 2 (R3)
  status        M34DictStatus @default(DRAFT)
  createdAt     DateTime      @default(now())

  dataSet M34DataSet           @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  fields  M34DictionaryField[]

  @@unique([dataSetId, version])
}

// Một trường trong từ điển — đúng 8 cột của F34.01 phần II
model M34DictionaryField {
  id             String  @id @default(cuid())
  versionId      String
  fieldName      String
  meaning        String
  dataType       String
  unit           String?
  validDomain    String?
  required       Boolean @default(false)
  validationRule String?
  example        String?

  version M34DictionaryVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, fieldName])
}

model M34MasterDataSource {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "DC-2026-0001"

  masterType        String // vd "Danh mục khách hàng"
  dataSetId         String
  sourceSystem      String // nguồn sự thật duy nhất — hệ thống, bảng
  authorizedEditors String
  syncTargets       String[] // → M37

  status         M34MasterStatus @default(DE_NGHI)
  reason         String?
  recognizedById String? // LĐV — không ủy quyền (ETV.P34 §5.1)
  recognizedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataSet   M34DataSet                 @relation(fields: [dataSetId], references: [id])
  findings  M34ParallelLookupFinding[]
  mergeMaps M34MasterMergeMap[]
}

// Lịch sử ánh xạ hợp nhất bản ghi dữ liệu chủ trùng — không xóa cứng (§6.4.4)
model M34MasterMergeMap {
  id             String   @id @default(cuid())
  masterSourceId String
  oldRef         String
  survivingRef   String
  note           String?
  createdAt      DateTime @default(now())

  masterSource M34MasterDataSource @relation(fields: [masterSourceId], references: [id])
}

model M34ParallelLookupFinding {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "BT-2026-0001"

  masterSourceId String
  description    String
  usedBy         String
  usedFor        String
  diffNote       String
  causedError    Boolean
  capaRef        String? // ← M13 — bắt buộc khi causedError (R10)
  stoppedAt      DateTime?
  resolvedAt     DateTime?

  status    M34FindingStatus @default(MOI)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  masterSource M34MasterDataSource @relation(fields: [masterSourceId], references: [id])
}

model M34QualityMeasurement {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "KD-2026-0001"

  dataSetId String
  period    String // vd "2026-Q3"

  measuredById String?
  measuredAt   DateTime?
  trend        M34Trend?

  status             M34QualityStatus       @default(MOI)
  belowThresholdCase M34BelowThresholdCase?
  remediationPlan    String?
  remediationDue     DateTime? // 15 ngày làm việc (đề xuất của dự thảo)
  capaRef            String? // ← M13 — bắt buộc khi dưới ngưỡng 02 kỳ liên tiếp (R15)
  validityRef        String? // ← M10/M11 khi có khả năng ảnh hưởng kết quả đã phát hành
  integrationRef     String? // ← M37 khi sai lệch từ tích hợp
  reason             String?

  concludedById String?
  concludedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataSet    M34DataSet      @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  measuredBy User?           @relation("M34QualityMeasured", fields: [measuredById], references: [id])
  rows       M34QualityRow[]

  @@unique([dataSetId, period])
  @@index([dataSetId, measuredAt])
}

model M34QualityRow {
  id            String              @id @default(cuid())
  measurementId String
  dimension     M34QualityDimension
  metric        String
  method        String?
  threshold     String
  value         String?
  passed        Boolean?

  measurement M34QualityMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@unique([measurementId, dimension])
}

model M34DataCorrection {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "HC-2026-0001"

  dataSetId        String
  recordPointer    String
  oldValue         String // R11 — giữ nguyên giá trị cũ trong hồ sơ
  newValue         String
  correctionReason String
  evidenceRef      String?

  requestedById String
  requestedAt   DateTime @default(now())

  publishedImpact    M34PublishedImpact?
  validityRef        String? // ← M10/M11 — bắt buộc khi DA_DUNG_PHAT_HANH (R12)
  validityConclusion M34ValidityConclusion?

  correctionRecordId String? // mã bản ghi hiệu chỉnh mới ở hệ thống nghiệp vụ
  performedById      String?
  performedAt        DateTime?
  capaRef            String? // ← M13 khi nguyên nhân hệ thống/lặp lại
  approvedById       String?

  status M34CorrectionStatus @default(MOI)
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataSet     M34DataSet @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("M34CorrectionRequested", fields: [requestedById], references: [id])
}

model M34SharingRequest {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "CS-2026-0001"

  requestType     M34SharingType
  dataSetId       String
  hasCustomerData Boolean // nghĩa vụ bảo mật ETV.P02, ISO/IEC 17025 §4.2

  requesterId String
  recipient   String? // bắt buộc khi RA_NGOAI_VIEN
  purpose     String
  scopeNote   String // trường, khoảng thời gian, số lượng bản ghi
  channel     String
  useUntil    DateTime?
  legalBasis  String? // bắt buộc khi RA_NGOAI_VIEN (§6.5.2 bước 2)

  // Biện pháp giảm thiểu — PT.ATTT xác định (§6.5.2 bước 3, R18)
  minScopeLimited     Boolean @default(false)
  minAnonymized       Boolean @default(false)
  minAnonymizeNA      String? // lý do không ẩn danh được
  minTimeLimited      Boolean @default(false)
  minProtectedChannel Boolean @default(false)
  minNdaRef           String?
  minReturnDelete     Boolean @default(false)

  atttOpinionById String?
  atttOpinionAt   DateTime?
  atttOpinionNote String?

  approvedById String? // CSHDL (nội bộ) / LĐV (ra ngoài)
  approvedAt   DateTime?

  executedById String? // ≠ người phê duyệt (§5.3)
  executedAt   DateTime?
  logRef       String?

  revokeDue         DateTime?
  revokeRequestedAt DateTime?
  revokeEvidenceRef String? // bằng chứng bên nhận đã xóa/trả

  status M34SharingStatus @default(DRAFT)
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataSet    M34DataSet @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  requester  User       @relation("M34SharingRequested", fields: [requesterId], references: [id])
  approvedBy User?      @relation("M34SharingApproved", fields: [approvedById], references: [id])
}

model M34AIDataApproval {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "DAI-2026-0001"

  dataSetId   String
  aiPurpose   M34AIPurpose
  aiSystemRef String? // mã AIPlatform/AIAgent bên M29
  aiaRef      String // hồ sơ AIA theo ETV.P29 — bắt buộc (R22)
  mitigation  String // ẩn danh dữ liệu cá nhân, giới hạn phạm vi truy xuất

  atttOpinionById String?
  approvedById    String?
  approvedAt      DateTime?

  status M34AIApprovalStatus @default(DE_NGHI)
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataSet    M34DataSet @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  approvedBy User?      @relation("M34AIApproved", fields: [approvedById], references: [id])
}

model M34AuditEntry {
  id       String      @id @default(cuid())
  itemType M34ItemType
  itemId   String
  ts       DateTime    @default(now())
  actorId  String
  role     String
  action   String
  reason   String?

  actor User @relation(fields: [actorId], references: [id])

  @@index([itemType, itemId])
}

// ---------- M33 — Quản lý hệ thống thông tin ----------
// Nguồn: Thủ tục ETV.P33 (DỰ THẢO lần BH 01, Chờ soát xét) + 05_MODULE_LIBRARY/M33_HeThongTT/
// 01_Requirement/DacTa.md (nguồn sự thật, 22 quy tắc R1–R22) và 03_Database/DataModel.md.
// Nguyên tắc xuyên suốt: không có DELETE trên M33ITAsset/M33SystemAccount — thiết bị có thể rời
// Viện, bản ghi kiểm kê thì không; mã tài sản không bao giờ cấp lại (R22); schema KHÔNG có cột nào
// lưu bí mật xác thực — chỉ nơi lưu + người cấp phát (R7, ETV.P33 Phụ lục I.1 điều kiện 7).

enum M33AssetClass {
  MAY_CHU // vật lý/ảo
  THIET_BI_MANG // switch, router, firewall, access point
  MAY_TRAM // máy trạm – máy tính xách tay
  THIET_BI_DI_DONG
  MAY_TINH_DIEU_KHIEN_DO // máy tính điều khiển – thu thập dữ liệu của thiết bị đo (vùng đặc biệt R4)
  THIET_BI_LUU_TRU // NAS, ổ cứng ngoài, băng từ
  THIET_BI_NGOAI_VI // máy in, máy quét, UPS
  PHAN_MEM_BAN_QUYEN
  DICH_VU_THUE_NGOAI // đám mây, hosting, email, tên miền, chứng thư số máy chủ
  THIET_BI_KY_SO // USB token
}

enum M33NetworkZone {
  QUAN_TRI_VAN_PHONG
  THIET_BI_DO // vùng thiết bị đo và hệ thống thu thập dữ liệu
  KHACH_WIFI
  KHONG_NOI_MANG
}

enum M33Environment {
  VAN_HANH
  KIEM_THU
  PHAT_TRIEN
}

enum M33Criticality {
  THAP
  TRUNG_BINH
  CAO // bắt buộc RTO + failover + ≥1 rủi ro; rà soát ≤ 1 năm (ETV.P33 §6.1.3)
}

enum M33DiscoverySource {
  KIEM_KE_KY_DAU
  MUA_SAM_MOI
  PHAT_HIEN_CHUA_KIEM_KE // R17 — hạn đưa vào vận hành 30 ngày
}

enum M33AssetStatus {
  DRAFT
  PENDING_REVIEW
  REVIEW_REJECTED
  PENDING_APPROVAL
  APPROVAL_REJECTED
  OPERATING // Đang vận hành
  SUSPENDED // Tạm ngừng (bảo trì lớn/sự cố)
  RETIRED // Ngừng vận hành — chưa thanh lý, dữ liệu chưa xử lý xong
  DISPOSED // Đã thanh lý — bản ghi kiểm kê vẫn giữ, mã không cấp lại
  CANCELLED // Hủy bản ghi (khai báo sai/trùng, trước phê duyệt)
}

enum M33MaintenanceCycle {
  THANG
  QUY
  SAU_THANG
  NAM
  THEO_KHUYEN_CAO_HANG
}

enum M33MaintenanceType {
  BAO_TRI_DINH_KY // bắt buộc thuộc kế hoạch năm đã phê duyệt (R19)
  VA_LOI_BAO_MAT // bắt buộc severity — mốc 07/30/90 ngày (§6.3.3)
  CAP_NHAT_PHIEN_BAN
  SUA_CHUA_SU_CO
  SAO_LUU_KIEM_TRA_KHOI_PHUC // phối hợp M27
  THAY_THE_LINH_KIEN
}

enum M33Severity {
  NGHIEM_TRONG // 07 ngày; chưa vá được ⇒ giảm thiểu tạm thời trong 48 giờ
  CAO // 30 ngày
  TRUNG_BINH // 90 ngày
  THAP // theo chu kỳ bảo trì kế tiếp
}

enum M33TaskResult {
  THANH_CONG
  THAT_BAI
  HOAN
}

enum M33TaskStatus {
  KE_HOACH
  DANG_THUC_HIEN
  CHO_NGHIEM_THU // bắt buộc đi qua — không có đường thẳng sang Hoàn thành (R15)
  HOAN_THANH
  HUY
}

enum M33PlanStatus {
  DRAFT
  CHO_PHE_DUYET
  DA_PHE_DUYET
  THAY_THE
}

enum M33AccountType {
  CA_NHAN_DINH_DANH
  DAC_QUYEN_QUAN_TRI // bắt buộc MFA
  DICH_VU_HE_THONG
  BEN_THU_BA
  DUNG_CHUNG_NGOAI_LE // bắt buộc sharedApprovalRef
}

enum M33AccountStatus {
  DANG_HOAT_DONG
  TAM_KHOA
  DA_THU_HOI
}

enum M33ReconScope {
  TOAN_BO // 06 tháng/lần
  DAC_QUYEN_DICH_VU // ≥ 02 lần/năm, trình LĐV
}

enum M33ReconStatus {
  DANG_THUC_HIEN
  DA_CHOT // bất biến, lưu 05 năm
}

enum M33IncidentKind {
  SU_CO
  YEU_CAU_HO_TRO
}

enum M33Impact {
  NGUNG_TOAN_VIEN
  NGUNG_MOT_PHONG
  ANH_HUONG_MOT_NGUOI
  KHONG_ANH_HUONG
}

enum M33Priority {
  CAO // phản hồi ngay, báo LĐV trong 01 giờ; xử lý theo RTO
  TRUNG_BINH // phản hồi 04 giờ làm việc; xử lý 02 ngày làm việc
  THAP // phản hồi 01 ngày làm việc; xử lý 05 ngày làm việc
}

enum M33IncidentStatus {
  MOI
  DANG_XU_LY
  CHO_BEN_THU_BA
  DA_XU_LY
  DA_DONG
  HUY
}

enum M33ItemType {
  ASSET
  PLAN
  TASK
  ACCOUNT
  RECONCILIATION
  INCIDENT
}

model M33ITAsset {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "HT-2026-0001" — cấp một lần, không đổi, không cấp lại (R22)

  name       String
  assetClass M33AssetClass
  model      String?
  serial     String? @unique // nhận dạng duy nhất thiết bị vật lý

  networkZone M33NetworkZone?
  environment M33Environment  @default(VAN_HANH)
  location    String

  userOwnerId String // người/đơn vị sử dụng — R1, NOT NULL ngay khi lưu
  custodianId String // QTHT quản trị kỹ thuật — R1

  criticality M33Criticality @default(THAP)

  platformRefs       String[] // → M35 (ref mềm) — dịch vụ thuê ngoài đồng thời là nền tảng (R2b)
  infoAssetRefs      String[] // → M27
  measuringDeviceRef String? // → M05 — bắt buộc khi assetClass = MAY_TINH_DIEU_KHIEN_DO (R4)

  maxClassification      Classification @default(NOI_BO) // thang dùng chung ETV.P02/P27/P28
  diskEncryption         Boolean        @default(false) // bắt buộc khi Hạn chế/Mật (R3)
  screenLock             Boolean?
  antimalware            Boolean?
  defaultPasswordChanged Boolean?
  unusedServicesClosed   Boolean?

  osVersion     String?
  patchLevel    String?
  lastPatchedAt DateTime?

  commissionedAt    DateTime? // ngày đưa vào vận hành
  handoverRecordRef String? // biên bản bàn giao thiết bị

  isPersonalDevice Boolean @default(false) // BYOD — mục 4.5
  byodApprovalRef  String? // phê duyệt LĐV khi BYOD xử lý Hạn chế/Mật

  licenseType            String?
  licenseExpiry          DateTime?
  warrantyUntil          DateTime?
  maintenanceContractRef String? // → M07
  eolDate                DateTime?
  replacementPlan        String? // kế hoạch thay thế có mốc thời gian — R11

  maintenanceCycle M33MaintenanceCycle @default(NAM)
  lastMaintainedAt DateTime?

  recoveryTimeObjective String? // bắt buộc khi criticality = CAO
  failoverPlan          String? // bắt buộc khi criticality = CAO — Phụ lục I.1 điều kiện 5
  riskRefs              String[] // → M28/M01 — bắt buộc khi Cao hoặc EOL còn vận hành (R11)

  reviewCycleMonths Int       @default(12) // Cao ⇒ ≤ 12 (§6.1.3)
  lastReviewedAt    DateTime?

  discoverySource M33DiscoverySource @default(KIEM_KE_KY_DAU)
  inventoryDueAt  DateTime? // chỉ khi PHAT_HIEN_CHUA_KIEM_KE: ngày lập + 30 ngày (R17)
  networkIsolated Boolean            @default(false) // đã ngắt khỏi mạng do không đạt cấu hình cơ sở (§6.7)

  status M33AssetStatus @default(DRAFT)
  reason String? // lý do trả lại/tạm ngừng/ngừng/thanh lý/hủy gần nhất

  disposalEvidenceRef String? // bằng chứng xóa dữ liệu an toàn ← M27 — điều kiện thanh lý (R10)

  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userOwner  User  @relation("M33AssetUserOwner", fields: [userOwnerId], references: [id])
  custodian  User  @relation("M33AssetCustodian", fields: [custodianId], references: [id])
  createdBy  User  @relation("M33AssetCreated", fields: [createdById], references: [id])
  approvedBy User? @relation("M33AssetApproved", fields: [approvedById], references: [id])

  tasks     M33MaintenanceTask[]
  plans     M33MaintenancePlan[]
  accounts  M33SystemAccount[]
  incidents M33ITIncident[]

  @@index([status, assetClass])
  @@index([eolDate])
  @@index([licenseExpiry])
  @@index([warrantyUntil])
  @@index([lastMaintainedAt])
  @@index([lastReviewedAt])
  @@index([inventoryDueAt])
}

model M33MaintenancePlan {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "KHBT-2027"

  year          Int
  downtimeNeeds String? // nhu cầu ngừng dịch vụ (§6.3.1)
  resourceNeeds String?

  status M33PlanStatus @default(DRAFT)
  reason String?

  createdById  String
  approvedById String? // LĐV — trước khi bắt đầu năm kế hoạch; ≠ createdBy (R19)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy  User  @relation("M33PlanCreated", fields: [createdById], references: [id])
  approvedBy User? @relation("M33PlanApproved", fields: [approvedById], references: [id])

  scopeAssets M33ITAsset[] // tài sản có hệ điều hành/phần mềm nền thuộc phạm vi
  tasks       M33MaintenanceTask[]
}

model M33MaintenanceTask {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "BT-2026-0001"

  taskType M33MaintenanceType
  severity M33Severity? // bắt buộc khi VA_LOI_BAO_MAT — quyết định mốc 07/30/90 ngày

  plannedAt DateTime?
  dueAt     DateTime?

  planId               String? // bắt buộc khi BAO_TRI_DINH_KY (R19)
  changeRef            String? // phiếu F30.02 ← M30 — bắt buộc khi thay đổi cấu hình ngoài định kỳ (R5)
  impactAssessmentRef  String? // đánh giá ảnh hưởng ATTT ← M28 — bắt buộc khi có changeRef (R5)
  measurementImpactRef String? // ← M10 — bắt buộc với máy tính điều khiển thiết bị đo (R4)
  methodImpactRef      String? // ← M08 khi chạm phương pháp (§6.3.4)
  emergencyOrderRef    String? // lệnh LĐV khẩn cấp — KHÔNG miễn changeRef hồi tố (Phụ lục I.2)

  userNotifiedAt DateTime? // thông báo trước khi gây gián đoạn (§6.3.2 bước 3)

  performedById String?
  performedAt   DateTime?
  result        M33TaskResult?
  evidenceRef   String? // nhật ký công việc, ảnh, kết quả kiểm tra, phiên bản sau cập nhật

  acceptedById String? // TP hoặc QTHT KHÁC người thực hiện — R15
  acceptedAt   DateTime?

  postCheckResult String? // bắt buộc với máy tính điều khiển thiết bị đo sau khi áp dụng (§6.3.4)
  downtimeMinutes Int?

  status M33TaskStatus @default(KE_HOACH)
  reason String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User  @relation("M33TaskCreated", fields: [createdById], references: [id])
  performedBy User? @relation("M33TaskPerformed", fields: [performedById], references: [id])
  acceptedBy  User? @relation("M33TaskAccepted", fields: [acceptedById], references: [id])

  plan   M33MaintenancePlan? @relation(fields: [planId], references: [id])
  assets M33ITAsset[] // ≥ 1 — kiểm ở rules

  @@index([status, dueAt])
}

model M33SystemAccount {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "TK-2026-0001"

  assetId     String? // tài khoản tồn tại trên tài sản nào…
  platformRef String? // …hoặc nền tảng nào (→ M35) — một trong hai, kiểm ở rules

  loginName   String
  accountType M33AccountType
  holderId    String? // bắt buộc khi ≠ DICH_VU_HE_THONG
  holderNote  String? // bên thứ ba không có tài khoản User

  accessRequestRef String // phiếu F28.04 đã phê duyệt ở M28 — R6, NOT NULL
  grantedAt        DateTime

  // R7 — chỉ NƠI LƯU và NGƯỜI CẤP PHÁT; schema không có cột giá trị bí mật
  secretLocation String
  secretIssuer   String

  mfaEnabled Boolean   @default(false) // bắt buộc với đặc quyền, truy cập từ xa, hệ chứa Hạn chế/Mật
  validUntil DateTime?

  sharedApprovalRef String? // bắt buộc khi DUNG_CHUNG_NGOAI_LE
  lastReviewRef     String? // kỳ rà soát quyền gần nhất bên M28

  hrEventRef      String? // ← M03 — biến động nhân sự
  revocationDueAt DateTime? // = cuối ngày làm việc phát sinh sự kiện (R16)
  revokedAt       DateTime?

  status M33AccountStatus @default(DANG_HOAT_DONG)
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holder User?       @relation("M33AccountHolder", fields: [holderId], references: [id])
  asset  M33ITAsset? @relation(fields: [assetId], references: [id])

  @@index([status, revocationDueAt])
  @@index([validUntil])
}

model M33AccountReconciliation {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "KYDC-2026-0001"

  period String // vd "2026-H1"
  scope  M33ReconScope

  // Bốn nhóm bất thường — SNAPSHOT tại thời điểm chốt, không tính lại (R20)
  orphanAccountIds  String[] // tài khoản không có phiếu
  orphanRequestRefs String[] // phiếu không có tài khoản
  expiredAccountIds String[] // quá validUntil
  mfaMissingIds     String[] // đặc quyền thiếu MFA

  performedById    String
  reviewedById     String? // PT.ATTT — kỳ đặc quyền/dịch vụ (§6.4.2 bước 5)
  submittedToLdvAt DateTime? // bắt buộc khi scope = DAC_QUYEN_DICH_VU (R20)

  status   M33ReconStatus @default(DANG_THUC_HIEN)
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  performedBy User @relation("M33ReconPerformed", fields: [performedById], references: [id])

  @@unique([period, scope])
}

model M33ITIncident {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "SC-2026-0001"

  kind        M33IncidentKind
  reportedById String
  reportedAt  DateTime        @default(now())
  description String

  impact   M33Impact
  priority M33Priority // tự tính theo bảng 4.6 + 3 điều kiện nâng bắt buộc lên Cao

  responseDueAt    DateTime?
  respondedAt      DateTime?
  resolutionDueAt  DateTime?
  escalatedToLdvAt DateTime? // priority CAO: trong 01 giờ (R18)

  securityFlag        Boolean @default(false)
  securityIncidentRef String? // → M28 (F28.03) — bắt buộc khi securityFlag; chặn đóng khi M28 chưa kết luận (R9)
  securityConcluded   Boolean @default(false) // M28 đã kết luận — điều kiện mở khóa đóng phiếu
  platformIncidentRef String? // → M35 (F35.03)
  measurementImpactRef String? // → M10/M11 — dừng sử dụng kết quả liên quan (§6.5.3)
  continuityRef       String? // → M31 khi gián đoạn vượt ngưỡng
  capaRef             String? // → M13 — bắt buộc khi lặp ≥ 3 lần/90 ngày (R9)
  lessonRef           String? // → M26 — hoặc noLessonReason khi đóng (§6.5.4)
  noLessonReason      String?
  maintenanceRef      String? // công việc sửa chữa phát sinh

  assignedToId String?

  rootCause         String?
  resolution        String?
  assetBackToNormal Boolean?

  status M33IncidentStatus @default(MOI)
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportedBy User  @relation("M33IncidentReported", fields: [reportedById], references: [id])
  assignedTo User? @relation("M33IncidentAssigned", fields: [assignedToId], references: [id])

  assets M33ITAsset[] // ≥ 1 — kiểm ở rules

  @@index([status, priority])
  @@index([responseDueAt])
}

model M33AuditEntry {
  id       String      @id @default(cuid())
  itemType M33ItemType
  itemId   String
  ts       DateTime    @default(now())
  actorId  String
  role     String
  action   String
  reason   String?

  actor User @relation(fields: [actorId], references: [id])

  @@index([itemType, itemId])
}

// ============================================================================
// M27 — Quản trị dữ liệu và tài sản thông tin
// NGUỒN QUY ĐỊNH: Thủ tục ETV.P27 (lần BH 01, ban hành 26/08/2026) —
// 03_MANAGEMENT_SYSTEM/02_P/ETV.P27_QuanTriDuLieuTaiSanTT.md
// Biểu mẫu: ETV.P.F 27.01 (danh mục) · F 27.02 (bảng quy tắc xử lý).
//
// Hai điều bất biến của module này, đọc trước khi sửa schema:
//  1. KHÔNG có thao tác xoá M27InfoAsset. Bản ghi kiểm kê giữ vĩnh viễn làm bằng
//     chứng, kể cả sau khi dữ liệu đã huỷ (P27 §6.7.1, Phụ lục I.2). Tài sản kết
//     thúc vòng đời bằng status = DA_HUY, không phải bằng DELETE.
//  2. Thang phân loại dùng enum `Classification` toàn nền tảng — P27 §6.2 là
//     ĐỊNH NGHĨA GỐC của thang này; M33/M34 và các module sau kế thừa, không ai
//     định nghĩa lại. Đổi thang phải ban hành lại ETV.P27 theo ETV.P14.
// ============================================================================

/// Loại tài sản — DacTa M27 mục 4.1
enum M27AssetType {
  CSDL_DIEN_TU // Cơ sở dữ liệu, tập dữ liệu điện tử
  TEP_TAI_LIEU // Tệp tài liệu điện tử trên thư mục dùng chung
  HO_SO_GIAY // Hồ sơ giấy
  UNG_DUNG_NEN_TANG // Ứng dụng, nền tảng chứa dữ liệu (ManLab, aios-platform)
  VAT_MANG_TIN_ROI // Ổ cứng, USB, băng từ
  DICH_VU_BEN_THU_BA // Dữ liệu trên đám mây, thư điện tử thuê ngoài
  DU_LIEU_THIET_BI_DO // Dữ liệu đo trực tiếp từ thiết bị (← M05)
}

/// Nhóm dữ liệu nghiệp vụ — P27 §6.1.3, mỗi nhóm có mức phân loại TỐI THIỂU
enum M27DataDomain {
  KHACH_HANG // ≥ Hạn chế
  KET_QUA_DO // ≥ Hạn chế
  HIEU_CHUAN_CRM // ≥ Hạn chế
  NHAN_SU // ≥ Mật
  TAI_CHINH // ≥ Mật
  HE_THONG_QUAN_LY // ≥ Nội bộ
  NGHIEN_CUU // ≥ Nội bộ
  VAN_HANH_CNTT // ≥ Hạn chế
  PHUC_VU_AI // ≥ Nội bộ
}

/// Mức yêu cầu cho từng chiều C–I–A — P27 §6.1.4
enum M27CiaLevel {
  THAP
  TRUNG_BINH
  CAO
}

/// Tần suất sao lưu — bắt buộc khi backupRequired
enum M27BackupFrequency {
  NGAY
  TUAN
  THANG
  KHAC
}

/// Phương pháp huỷ dự kiến — P27 §6.7.4
enum M27DisposalMethod {
  CAT_VUN_GIAY
  XOA_AN_TOAN
  HUY_VAT_LY
  HUY_KHOA_MA_HOA
  BEN_THU_BA_XOA
}

/// Vòng đời bản ghi kiểm kê — P27 Phụ lục II.1 (9 trạng thái).
/// KHÔNG có giá trị nào nghĩa là "đã xoá" — xem ghi chú đầu khối M27.
enum M27AssetStatus {
  DRAFT // Nháp
  PENDING_REVIEW // Chờ soát xét
  REVIEW_REJECTED // Không soát xét (bắt buộc lý do)
  PENDING_APPROVAL // Chờ phê duyệt
  APPROVAL_REJECTED // Không phê duyệt (bắt buộc lý do)
  DANG_SU_DUNG // Đang sử dụng — có trong danh mục hiệu lực
  NGUNG_SU_DUNG // Ngừng sử dụng, vẫn trong thời hạn lưu
  DA_HUY // Đã huỷ — dữ liệu đã huỷ, bản ghi kiểm kê vẫn giữ
  CANCELLED // Huỷ bản ghi (khai báo sai/trùng, trước phê duyệt)
}

/// Hành động trong bảng quy tắc xử lý — P27 §6.3 liệt kê đúng 8 hành động này
enum M27RuleAction {
  LUU_TRU
  TRUYEN_GUI
  IN_SAO_CHEP
  MANG_RA_NGOAI
  CHIA_SE_BEN_THU_BA
  THIET_BI_CA_NHAN
  CHI_MUC_AI
  HUY
}

/// Vòng đời bảng quy tắc xử lý — P27 Phụ lục II.2
enum M27RuleVersionStatus {
  DRAFT
  PENDING_APPROVAL
  DA_PHE_DUYET
  HET_HIEU_LUC
}

enum M27ItemType {
  ASSET
  RULE_VERSION
}

/// Tài sản thông tin — biểu mẫu ETV.P.F 27.01, trình tự P27 §6.1.5
model M27InfoAsset {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // "TS-<năm>-<số>" — QLCL cấp một lần, KHÔNG cấp lại mã của tài sản đã huỷ (P27 §6.1.2)

  name        String
  assetType   M27AssetType
  dataDomain  M27DataDomain
  description String // nội dung dữ liệu chứa đựng — KHÔNG chép dữ liệu thật (Phụ lục I.1 điều kiện 8)

  classification Classification // thang dùng chung; P27 §6.2 là định nghĩa gốc
  ciaC           M27CiaLevel
  ciaI           M27CiaLevel
  ciaA           M27CiaLevel

  // Căn cứ hạ mức xuống dưới mức tối thiểu của nhóm dữ liệu (P27 §6.1.3): phê duyệt công bố
  // theo ETV.P02 (ref mềm → M02) hoặc quy định pháp luật bắt buộc công bố. Thiếu ⇒ chặn.
  classificationDowngradeRef String?

  containsPersonalData Boolean @default(false)
  personalDataScope    String? // phạm vi chủ thể và loại dữ liệu cá nhân (cơ bản/nhạy cảm) — P27 §6.4
  legalBasis           String? // căn cứ pháp lý + mục đích xử lý — bắt buộc khi containsPersonalData

  ownerId     String // chủ sở hữu — MỘT CÁ NHÂN, không phải phòng (P27 Phụ lục I.1 điều kiện 1)
  custodianId String? // người quản lý kỹ thuật — bắt buộc khi tài sản ở dạng điện tử (điều kiện 2)

  storageLocation String // nơi lưu vật lý hoặc logic
  systemRefs      String[] // → M33 (ref mềm, không FK chéo module)
  docRef          String? // → M14 khi tài sản là tài liệu kiểm soát
  recordRef       String? // → M15 khi tài sản là hồ sơ
  datasetRefs     String[] // → M34 tập dữ liệu số tương ứng

  retentionPeriod String // thời hạn lưu (điều kiện 5)
  retentionBasis  String // căn cứ thời hạn: ETV.P15 · ETV.P.F 14.06 · pháp luật chuyên ngành
  disposalMethod  M27DisposalMethod

  backupRequired    Boolean             @default(false) // bắt buộc true khi ciaA = CAO (điều kiện 7)
  backupFrequency   M27BackupFrequency?
  lastRestoreTestAt DateTime? // ngày kiểm chứng phục hồi gần nhất — chu kỳ theo P27 §6.5.2 (F31.03)

  externalSharingAllowed Boolean @default(false) // Hạn chế/Mật mặc định KHÔNG được phép (P27 §6.6)
  aiUseAllowed           Boolean @default(false) // chỉ bật được với Công khai/Nội bộ (P27 §6.9.2)

  riskRefs String[] // → M28/M01 (ref mềm). P27 §6.9.1: cảnh báo cho tới khi M28 vận hành, sau đó chặn phê duyệt

  reviewCycleMonths Int       @default(12) // 6 khi Mật hoặc có dữ liệu cá nhân — P27 §6.8
  lastReviewedAt    DateTime?

  status M27AssetStatus @default(DRAFT)
  reason String? // lý do trả lại/ngừng sử dụng/huỷ gần nhất

  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User  @relation("M27AssetOwner", fields: [ownerId], references: [id])
  custodian  User? @relation("M27AssetCustodian", fields: [custodianId], references: [id])
  createdBy  User  @relation("M27AssetCreated", fields: [createdById], references: [id])
  reviewedBy User? @relation("M27AssetReviewed", fields: [reviewedById], references: [id])
  approvedBy User? @relation("M27AssetApproved", fields: [approvedById], references: [id])

  @@index([status, dataDomain])
  @@index([classification])
  @@index([lastReviewedAt])
  @@index([lastRestoreTestAt])
  @@index([containsPersonalData])
}

/// Phiên bản bảng quy tắc xử lý — biểu mẫu ETV.P.F 27.02.
/// Mỗi lần sửa tạo phiên bản MỚI, không sửa đè; phiên bản cũ giữ làm bằng chứng (P27 §6.3).
model M27RuleVersion {
  id      String @id @default(cuid())
  version Int    @unique

  effectiveFrom DateTime?
  status        M27RuleVersionStatus @default(DRAFT)
  note          String?

  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedBy User?                 @relation("M27RulesApproved", fields: [approvedById], references: [id])
  rules      M27ClassificationRule[]

  @@index([status])
}

/// Một ô của ma trận (mức phân loại × hành động) — P27 §6.3
model M27ClassificationRule {
  id            String @id @default(cuid())
  ruleVersionId String

  classification Classification
  action         M27RuleAction
  requirement    String // yêu cầu bắt buộc khi thực hiện hành động
  isProhibited   Boolean        @default(false) // CẤM — chặn ở MỌI luồng thao tác (P27 §6.3, Phụ lục I.2)

  ruleVersion M27RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@unique([ruleVersionId, classification, action])
  @@index([classification, action])
}

model M27AuditEntry {
  id       String      @id @default(cuid())
  itemType M27ItemType
  itemId   String
  ts       DateTime    @default(now())
  actorId  String
  role     String
  action   String
  reason   String?

  actor User @relation(fields: [actorId], references: [id])

  @@index([itemType, itemId])
}

// ============================================================================
// M28 — Quản lý an toàn thông tin (ISMS)
// NGUỒN QUY ĐỊNH: Thủ tục ETV.P28 (lần BH 02, ban hành 26/08/2026) —
// 03_MANAGEMENT_SYSTEM/02_P/ETV.P28_QuanLyAnToanThongTin.md
// Biểu mẫu: F28.01 rủi ro+RTP · F28.02 SoA · F28.03 sự cố · F28.04 quyền truy cập.
//
// Ba điều bất biến, đọc trước khi sửa:
//  1. Mỗi rủi ro PHẢI gắn ít nhất một tài sản thông tin CÓ THẬT trong danh mục M27
//     (P28 mục 6.3, Phụ lục I mục 1). Ràng buộc này là ref mềm ở tầng schema (nền tảng
//     không dùng FK chéo module) nhưng được kiểm tra tồn tại ở tầng action — xem
//     `assetsExist` truyền vào rules. KHÔNG nới thành nhập văn bản tự do.
//  2. Rủi ro tồn dư từ 7 trở lên chỉ đóng được khi LĐV chấp nhận bằng văn bản, có lý do
//     (P28 mục 6.4.3). Không uỷ quyền cho vai trò khác.
//  3. SoA liệt kê ĐỦ 93 kiểm soát của Phụ lục A ISO/IEC 27001:2022 và chỉ lưu MÃ kiểm
//     soát + cách ETV thực thi. Chép toàn văn nội dung tiêu chuẩn vào DB là vi phạm bản
//     quyền và bị cấm bởi chính thủ tục (P28 mục 6.6).
// ============================================================================

/// Phương án xử lý rủi ro — P28 mục 6.5.1
enum M28TreatmentOption {
  GIAM_THIEU
  TRANH
  CHIA_SE
  CHAP_NHAN
}

/// Vòng đời bản ghi rủi ro — P28 Phụ lục II mục 1 (9 trạng thái)
enum M28RiskStatus {
  DRAFT // Nháp
  PENDING_REVIEW // Chờ soát xét
  REVIEW_REJECTED // Không soát xét (bắt buộc lý do)
  PENDING_APPROVAL // Chờ phê duyệt
  APPROVAL_REJECTED // Không phê duyệt (bắt buộc lý do)
  DANG_XU_LY // RTP đã phê duyệt, đang thực hiện biện pháp
  DA_XU_LY // Biện pháp hoàn thành VÀ đã xác nhận hiệu lực
  CHAP_NHAN_TON_DU // Đóng với mức tồn dư còn lại (LĐV khi R ≥ 7)
  HET_HIEU_LUC // Rủi ro không còn (tài sản/hoạt động đã chấm dứt)
}

enum M28TreatmentStatus {
  MO
  DANG_THUC_HIEN
  HOAN_THANH
}

enum M28SoAStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_APPROVAL
  DA_PHE_DUYET
  HET_HIEU_LUC
}

enum M28ImplementationStatus {
  CHUA_THUC_HIEN
  DANG_THUC_HIEN
  DA_THUC_HIEN
}

/// Phân mức sự cố — P28 mục 6.8.1. Quyết định thời hạn báo cáo và thẩm quyền đóng.
enum M28Severity {
  THAP // ≤ 24 giờ tới PT.ATTT · PT.ATTT đóng
  TRUNG_BINH // ≤ 08 giờ tới PT.ATTT · PT.ATTT đóng
  CAO // Ngay lập tức tới PT.ATTT và LĐV · LĐV đóng
  RAT_CAO // Ngay lập tức tới LĐV · LĐV đóng; kích hoạt ETV.P31 nếu gián đoạn
}

/// Vòng đời sự cố — P28 mục 6.8.2 (6 bước) và Phụ lục II mục 2
enum M28IncidentStatus {
  MOI
  DANG_KHONG_CHE
  DANG_DIEU_TRA
  DANG_KHAC_PHUC
  CHO_KET_LUAN
  DA_DONG
  HUY // cảnh báo giả — bắt buộc ghi lý do
}

enum M28TriState {
  CO
  KHONG
  CHUA_XAC_DINH
}

enum M28SubjectType {
  NHAN_SU_CHINH_THUC
  THU_VIEC
  CHUYEN_GIA_NHA_THAU
  NHA_CUNG_CAP_CNTT
}

enum M28RequestType {
  CAP_MOI
  THAY_DOI
  THU_HOI_MOT_PHAN
  THU_HOI_TOAN_BO
}

/// Vòng đời phiếu quyền truy cập — P28 Phụ lục II mục 2
enum M28AccessStatus {
  DE_NGHI
  CHO_PHE_DUYET
  DA_PHE_DUYET
  DA_THUC_HIEN
  TU_CHOI
  DA_THU_HOI
}

enum M28ReviewScope {
  PHONG // TP rà soát ≥ 06 tháng/lần
  TAI_KHOAN_DAC_QUYEN // LĐV rà soát ≥ 02 lần/năm
}

enum M28ItemType {
  RISK
  TREATMENT
  SOA_VERSION
  INCIDENT
  ACCESS_REQUEST
  ACCESS_REVIEW
}

/// Rủi ro an toàn thông tin — biểu mẫu ETV.P.F 28.01, trình tự P28 mục 6.4
model M28SecurityRisk {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // "RR-ATTT-<năm>-<số>"

  title String

  // Ref mềm tới mã tài sản của M27. Tồn tại được kiểm ở tầng action rồi truyền vào rule —
  // rủi ro không gắn được tài sản thì KHÔNG CHO LƯU (P28 Phụ lục I mục 1).
  assetRefs String[]

  classification Classification // mức phân loại thông tin bị ảnh hưởng, kế thừa M27
  threat         String
  vulnerability  String
  existingControls String?

  // Chấm điểm: T = max(C, I, A); R = K × T (P28 mục 6.4.2). Cả hai do hệ thống tính,
  // người dùng KHÔNG sửa tay được.
  impactC    Int // 1–5
  impactI    Int // 1–5
  impactA    Int // 1–5
  likelihood Int // 1–5 — K
  impact     Int // 1–5 — T, tự tính
  riskScore  Int // 1–25 — R, tự tính

  treatmentOption M28TreatmentOption

  // Kiểm soát trong SoA được viện tới để giảm rủi ro — bắt buộc khi chọn Giảm thiểu.
  soaControlRefs String[]

  ownerId String // chủ sở hữu rủi ro: TP hoặc LĐV, KHÔNG được là QTHT (P28 mục 6.4.3)

  residualLikelihood Int?
  residualImpact     Int?
  residualScore      Int?
  residualAcceptedById String? // BẮT BUỘC là LĐV khi residualScore ≥ 7 — không uỷ quyền
  residualAcceptedAt   DateTime?
  residualAcceptReason String?

  m01RiskRef String? // → M01 khi mức Cao/Rất cao
  bcpInput   Boolean @default(false) // tự tính: impactA ≥ 4 ⇒ đầu vào bắt buộc của ETV.P31

  lastAssessedAt DateTime? // mốc tính hạn rà soát 12 tháng (P28 mục 6.4.1)

  status M28RiskStatus @default(DRAFT)
  reason String?

  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner              User  @relation("M28RiskOwner", fields: [ownerId], references: [id])
  createdBy          User  @relation("M28RiskCreated", fields: [createdById], references: [id])
  reviewedBy         User? @relation("M28RiskReviewed", fields: [reviewedById], references: [id])
  approvedBy         User? @relation("M28RiskApproved", fields: [approvedById], references: [id])
  residualAcceptedBy User? @relation("M28RiskResidualAccepted", fields: [residualAcceptedById], references: [id])

  treatments M28RiskTreatment[]

  @@index([status, riskScore])
  @@index([classification])
  @@index([lastAssessedAt])
  @@index([bcpInput])
}

/// Hạng mục Kế hoạch xử lý rủi ro (RTP) — phần 2 của biểu mẫu F28.01, P28 mục 6.5.2
model M28RiskTreatment {
  id     String @id @default(cuid())
  riskId String

  measure       String
  soaControlRef String // mã kiểm soát tương ứng trong SoA
  responsibleId String
  resources     String?

  // Hạn theo mức rủi ro: ≤ 12 tháng (Trung bình) · ≤ 06 tháng (Cao) · ≤ 03 tháng (Rất cao)
  dueAt DateTime

  // Biện pháp khống chế tạm thời — BẮT BUỘC ngay với rủi ro mức Rất cao (P28 mục 6.4.3)
  interimMeasure String?

  verificationMethod String // cách xác nhận hiệu lực
  completedAt        DateTime?

  // Chưa xác nhận hiệu lực thì KHÔNG được ghi là hoàn thành (P28 mục 6.5.2)
  verifiedById String?
  verifiedAt   DateTime?

  status M28TreatmentStatus @default(MO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  risk        M28SecurityRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  responsible User            @relation("M28TreatmentResponsible", fields: [responsibleId], references: [id])
  verifiedBy  User?           @relation("M28TreatmentVerified", fields: [verifiedById], references: [id])

  @@index([riskId])
  @@index([status, dueAt])
}

/// Tuyên bố áp dụng — biểu mẫu ETV.P.F 28.02. Tài liệu BẮT BUỘC của ISMS (P28 mục 6.6).
/// Mỗi lần sửa tạo phiên bản mới, KHÔNG sửa đè; phiên bản cũ giữ làm bằng chứng.
model M28SoAVersion {
  id      String @id @default(cuid())
  version Int    @unique

  // Sáu chiều xác định phạm vi ISMS — P28 mục 6.1
  scopeOrganization String
  scopeLocation     String
  scopeInformation  String
  scopeSystems      String
  scopeInterfaces   String
  scopeExclusions   String? // phần bị loại khỏi phạm vi KÈM LÝ DO

  effectiveDate DateTime?
  supersedesId  String?

  approvedById String?
  approvedAt   DateTime?

  status M28SoAStatus @default(DRAFT)
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedBy User?           @relation("M28SoaApproved", fields: [approvedById], references: [id])
  controls   M28SoAControl[]

  @@index([status])
}

/// Một dòng kiểm soát của SoA. 93 dòng cho mỗi phiên bản — A.5 (37) · A.6 (8) · A.7 (14) · A.8 (34).
/// CHỈ lưu mã kiểm soát và cách ETV thực thi; KHÔNG lưu tên và diễn giải của tiêu chuẩn.
model M28SoAControl {
  id           String @id @default(cuid())
  soaVersionId String

  controlCode String // "A.5.9" — theo Phụ lục A ISO/IEC 27001:2022
  theme       String // "A.5" Tổ chức · "A.6" Con người · "A.7" Vật lý · "A.8" Công nghệ

  applicable Boolean @default(true)

  justification   String? // bắt buộc khi Áp dụng: rủi ro tương ứng, pháp luật, hợp đồng, yêu cầu tiêu chuẩn
  exclusionReason String? // BẮT BUỘC khi Loại trừ — không chấp nhận lý do chung chung (P28 mục 6.6)
  implementation  String? // thủ tục/quy định/biện pháp nội bộ đang thực thi kiểm soát
  responsibleId   String?

  implementationStatus M28ImplementationStatus @default(CHUA_THUC_HIEN)
  evidenceRefs         String[] // dẫn chiếu hồ sơ ETV.P15 hoặc bản ghi trên ManLab
  evidenceDueAt        DateTime? // quá hạn mà rỗng ⇒ lập KPH theo ETV.P13

  soaVersion  M28SoAVersion @relation(fields: [soaVersionId], references: [id], onDelete: Cascade)
  responsible User?         @relation("M28ControlResponsible", fields: [responsibleId], references: [id])

  @@unique([soaVersionId, controlCode])
  @@index([applicable, implementationStatus])
  @@index([evidenceDueAt])
}

/// Sự cố an toàn thông tin — biểu mẫu ETV.P.F 28.03, trình tự P28 mục 6.8.2.
/// Đây là HỒ SƠ GỐC về sự cố: ETV.P02 và M29 dẫn chiếu tới phiếu này, không lập bộ song song.
model M28SecurityIncident {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // "SC-ATTT-<năm>-<số>"

  reporterId String // ai cũng báo được, kể cả nhân sự không có quyền quản trị

  occurredAt DateTime? // có thể ước lượng
  detectedAt DateTime
  reportedAt DateTime

  symptom   String
  assetRefs String[] // → M27

  classification         Classification
  involvesCustomerData   M28TriState    @default(CHUA_XAC_DINH)
  involvesPersonalData   M28TriState    @default(CHUA_XAC_DINH)

  severity M28Severity

  containedAt        DateTime?
  containmentActions String?
  evidencePreserved  String? // bằng chứng đã thu thập và nơi lưu — cấm xoá khi đang xử lý

  directCause   String?
  scopeOfImpact String?

  // true ⇒ BẮT BUỘC kích hoạt ETV.P10 và ETV.P11; module KHÔNG tự kết luận hiệu lực kết quả đo
  affectsResultValidity Boolean @default(false)
  m10Ref                String?
  m11Ref                String?

  // Nghĩa vụ thông báo ra bên ngoài — P28 mục 6.8.3. Quyết định gửi thuộc LĐV.
  notifications Json? // [{ doiTuong, canCu, nguoiQuyetDinh, ngayGui, bangChung }]

  recoveryAt DateTime?
  riskRefs   String[] // rủi ro đã cập nhật hoặc mở mới sau sự cố
  capaRef    String? // → M13 khi có sự không phù hợp
  lessonRef  String? // → M26 — BẮT BUỘC khi severity ∈ {CAO, RAT_CAO} mới được đóng

  closedById String?
  closedAt   DateTime?

  status M28IncidentStatus @default(MOI)
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter User  @relation("M28IncidentReporter", fields: [reporterId], references: [id])
  closedBy User? @relation("M28IncidentClosed", fields: [closedById], references: [id])

  @@index([status, severity])
  @@index([detectedAt])
  @@index([classification])
}

/// Phiếu yêu cầu cấp/thay đổi/thu hồi quyền truy cập — biểu mẫu ETV.P.F 28.04, P28 mục 6.7.1.
/// Ba vai trò đề nghị / phê duyệt / thực hiện PHẢI khác nhau.
model M28AccessRequest {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // "QTC-<năm>-<số>"

  subjectId       String? // người được cấp quyền, khi là nhân sự của Viện
  subjectExternal String? // tên và tổ chức, khi là bên thứ ba
  subjectType     M28SubjectType

  ndaRef               String? // cam kết bảo mật đã ký (F02.01/.02/.04) — bắt buộc với bên thứ ba
  awarenessTrainingRef String? // đào tạo nhận thức ATTT — chưa có thì CHẶN cấp quyền

  requestType M28RequestType
  reason      String

  // [{ heThong, vaiTro, isPrivileged, mucPhanLoai, validUntil }]
  items Json

  // Tự tính: bắt buộc MFA khi có tài khoản đặc quyền, truy cập từ xa, thư điện tử công vụ,
  // hoặc hệ thống chứa thông tin mức Hạn chế/Mật (P28 mục 6.7.1).
  mfaRequired Boolean @default(false)

  requestedById String // TP đề nghị
  approvedById  String? // PT.ATTT hoặc LĐV theo mức nhạy cảm
  approvedAt    DateTime?
  executedById  String? // QTHT thực hiện — KHÔNG tự quyết định quyền
  executedAt    DateTime?

  systemLogRef String? // mã nhật ký hệ thống của thao tác

  revokedAt      DateTime? // thu hồi trong ngày làm việc khi chấm dứt/chuyển công tác
  assetsReturned Boolean   @default(false) // thiết bị, thẻ ra vào, USB token chữ ký số

  status M28AccessStatus @default(DE_NGHI)
  // `reason` ở trên là lý do ĐỀ NGHỊ cấp quyền; trường này là lý do của lần đổi trạng thái
  // gần nhất (từ chối, thu hồi) — bắt buộc ghi theo P28 Phụ lục II.
  statusReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject     User? @relation("M28AccessSubject", fields: [subjectId], references: [id])
  requestedBy User  @relation("M28AccessRequested", fields: [requestedById], references: [id])
  approvedBy  User? @relation("M28AccessApproved", fields: [approvedById], references: [id])
  executedBy  User? @relation("M28AccessExecuted", fields: [executedById], references: [id])

  @@index([status, requestType])
  @@index([revokedAt])
}

/// Đợt rà soát quyền truy cập định kỳ — phần 6 của biểu mẫu F28.04, P28 mục 6.7.1
model M28AccessReview {
  id     String         @id @default(cuid())
  period String // kỳ rà soát, vd "2026-H1"
  scope  M28ReviewScope

  department String? // khi scope = PHONG

  accountsReviewed Int @default(0)
  excessFound      Int @default(0)
  revoked          Int @default(0)

  // Quyền thừa phải được thu hồi BẰNG PHIẾU, không thu hồi ngầm
  revocationRefs String[]

  reviewerId String
  reviewedAt DateTime

  createdAt DateTime @default(now())

  reviewer User @relation("M28AccessReviewer", fields: [reviewerId], references: [id])

  @@index([scope, reviewedAt])
}

model M28AuditEntry {
  id       String      @id @default(cuid())
  itemType M28ItemType
  itemId   String
  ts       DateTime    @default(now())
  actorId  String
  role     String
  action   String
  reason   String?

  actor User @relation(fields: [actorId], references: [id])

  @@index([itemType, itemId])
}
