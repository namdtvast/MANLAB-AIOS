model M03Employee {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "NS-2026-0001"

  fullName              String
  position              String
  department            String
  employmentType        M03EmploymentType
  hireDate              DateTime
  status                M03EmployeeStatus @default(THUVIEC)
  securityCommitmentRef String            @default("") // tham chiếu tự do M02 — chưa có backend thật

