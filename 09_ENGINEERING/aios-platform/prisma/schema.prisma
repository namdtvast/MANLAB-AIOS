// ---------- M16_DanhGiaNoiBo — xây mới từ 05_MODULE_LIBRARY/M16_DanhGiaNoiBo/01_Requirement/DacTa.md ----------
// Không có 08_Source nguyên mẫu (giống M01/M02/M03/M04) — logic port từ ETV.P16_DanhGiaNoiBo.md
// (Đã phê duyệt, lần 03), xem 01_Requirement/_work/20260823-xay-moi-m16/spec.md để đối chiếu
// "Quyết định phạm vi" (mô hình 2 bước duyệt tường minh; chỉ gate cứng mốc 7 ngày).

enum M16AuditType {
  NOI_BO
  BEN_NGOAI
}

enum M16PlanStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum M16ProgramStatus {
  DRAFT
  CONFIRMED
  CLOSED // quy tắc 7 ETV.P16 — LĐP thẩm tra sau khắc phục mới được đóng (Increment 13)
}

// Quy tắc 1 ETV.P16 — năng lực đánh giá viên, mỗi loại phải có bằng chứng thật (Increment 13).
enum M16QualType {
  ISO_17025 // đã đào tạo ISO/IEC 17025
  DANH_GIA_NOI_BO // đã đào tạo đánh giá nội bộ
  KINH_NGHIEM_TRUONG_DOAN // kinh nghiệm đánh giá nội bộ — điều kiện riêng của trưởng đoàn
}

enum M16Conformity {
  PHU_HOP
  KHONG_PHU_HOP
}

enum M16ItemType {
  PLAN
  PROGRAM
  REPORT
}

model M16AuditPlan {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "KHDG-2026-0001"

  type     M16AuditType
  year     Int
  scope    String[]
  auditors String[]
  isAdHoc  Boolean       @default(false)
  status   M16PlanStatus @default(DRAFT)
  reason   String?

  createdById  String
  reviewedById String?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quy tắc 7 ETV.P16 — kế hoạch đánh giá bổ sung do LĐP/QLCL đề xuất khi thẩm tra chưa đủ tin
  // cậy; trỏ ngược về chương trình đã phát sinh đề xuất (Increment 13).
  followUpOfProgramId String?

  createdBy  User  @relation("M16PlanCreated", fields: [createdById], references: [id])
  reviewedBy User? @relation("M16PlanReviewed", fields: [reviewedById], references: [id])
  approvedBy User? @relation("M16PlanApproved", fields: [approvedById], references: [id])

  followUpOfProgram M16AuditProgram? @relation("M16FollowUpAudit", fields: [followUpOfProgramId], references: [id])

  programs M16AuditProgram[]
}

model M16AuditProgram {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "CTDG-2026-0001"

  planId             String
  department         String
  field              String
  auditDate          DateTime
  // teamLeadName/teamMembers giữ lại làm BẢN CHỤP tên tại thời điểm lập chương trình (hồ sơ lưu
  // theo ETV.P15 phải giữ tên đúng lúc đó); FK teamLeadEmployeeId + M16ProgramMember mới là
  // nguồn dùng để validate năng lực (quy tắc 1, Increment 13).
  teamLeadName       String
  teamMembers        String[]
  teamLeadEmployeeId String?
  status             M16ProgramStatus @default(DRAFT)
  confirmedAt        DateTime?

  // Quy tắc 7 ETV.P16 — LĐP đóng chương trình sau khi thẩm tra hành động khắc phục.
  closedAt    DateTime?
  closedById  String?
  closureNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan             M16AuditPlan @relation(fields: [planId], references: [id])
  teamLeadEmployee M03Employee? @relation("M16TeamLead", fields: [teamLeadEmployeeId], references: [id])
  closedBy         User?        @relation("M16ProgramClosed", fields: [closedById], references: [id])

  members       M16ProgramMember[]
  findings      M16AuditFinding[]
  reports       M16AuditReport[]
  followUpPlans M16AuditPlan[]     @relation("M16FollowUpAudit")
}

// Quy tắc 1 ETV.P16 — thành viên đoàn đánh giá là nhân sự thật của M03, không phải tên tự do.
model M16ProgramMember {
  id         String @id @default(cuid())
  programId  String
  employeeId String

  createdAt DateTime @default(now())

  program  M16AuditProgram @relation(fields: [programId], references: [id])
  employee M03Employee     @relation("M16ProgramMember", fields: [employeeId], references: [id])

  @@unique([programId, employeeId])
}

// Quy tắc 1 ETV.P16 — sổ năng lực đánh giá viên. QLCL công nhận từng loại năng lực, bằng chứng là
// HỒ SƠ ĐÀO TẠO THẬT của M03 (result = DAT, status = APPROVED) — không có cờ "đã đào tạo" tự khai.
// Loại KINH_NGHIEM_TRUONG_DOAN không có hồ sơ tương ứng trong M03 nên bắt buộc ghi note thay thế.
model M16AuditorQualification {
  id         String      @id @default(cuid())
  employeeId String
  qualType   M16QualType

  trainingRecordId String?
  note             String?

  recognizedById String
  recognizedAt   DateTime @default(now())

  employee       M03Employee        @relation("M16Qualification", fields: [employeeId], references: [id])
  trainingRecord M03TrainingRecord? @relation("M16QualEvidence", fields: [trainingRecordId], references: [id])
  recognizedBy   User               @relation("M16QualRecognized", fields: [recognizedById], references: [id])

  @@unique([employeeId, qualType])
}

model M16AuditFinding {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "PH-2026-0001"

  programId        String
  clauseRef        String
  department       String
  description      String
  conformity       M16Conformity
  evidence         String?
  auditorSignature String
  capaRef          String? // DEPRECATED từ Increment 13 — giữ cho dữ liệu cũ, thay bằng ncwId

  // Quy tắc 6 ETV.P16 — Trưởng bộ phận được đánh giá nhận kết quả, phân tích nguyên nhân rồi đề
