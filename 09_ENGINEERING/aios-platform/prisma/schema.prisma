// MANLAB-AIOS platform — schema Prisma
// Nguồn sự thật về danh sách 38 module lấy từ 05_MODULE_LIBRARY/Mxx_Slug/
// (seed bằng prisma/seed.ts, quét trực tiếp repo — không hardcode 2 nơi).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth / Auth.js — Prisma adapter) ----------

enum PlatformRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          PlatformRole @default(VIEWER)
  createdAt     DateTime     @default(now())

  accounts    Account[]
  sessions    Session[]
  moduleRoles ModuleRoleAssignment[]

  m10Created      M10Assessment[] @relation("M10Created")
  m10Reviewed     M10Assessment[] @relation("M10Reviewed")
  m10Approved     M10Assessment[] @relation("M10Approved")
  m10AuditEntries M10AuditEntry[]

  m21Created      M21Record[]     @relation("M21Created")
  m21AuditEntries M21AuditEntry[]

  m29AuditEntries AIAuditLog[]

  m29IncidentDetected     AIIncident[]             @relation("AIIncidentDetected")
  m29IncidentAssessed     AIIncident[]             @relation("AIIncidentAssessed")
  m29IncidentClosed       AIIncident[]             @relation("AIIncidentClosed")
  m29UnregisteredDetected AIUnregisteredSighting[] @relation("AIUnregisteredDetected")

  m01RiskCreated  M01RiskItem[] @relation("M01RiskCreated")
  m01RiskReviewed M01RiskItem[] @relation("M01RiskReviewed")
  m01RiskApproved M01RiskItem[] @relation("M01RiskApproved")
  m01RiskAssigned M01RiskItem[] @relation("M01RiskAssigned")
  m01RiskVerified M01RiskItem[] @relation("M01RiskVerified")

  m01OppCreated  M01OpportunityItem[] @relation("M01OppCreated")
  m01OppReviewed M01OpportunityItem[] @relation("M01OppReviewed")
  m01OppApproved M01OpportunityItem[] @relation("M01OppApproved")
  m01OppAssigned M01OpportunityItem[] @relation("M01OppAssigned")
  m01OppVerified M01OpportunityItem[] @relation("M01OppVerified")

  m01AuditEntries M01AuditEntry[]

  m03RecruitmentCreated  M03RecruitmentPlan[]     @relation("M03RecruitmentCreated")
  m03RecruitmentApproved M03RecruitmentPlan[]     @relation("M03RecruitmentApproved")
  m03TrainingApproved    M03TrainingRecord[]      @relation("M03TrainingApproved")
  m03ContractSigned      M03LaborContract[]       @relation("M03ContractSigned")
  m03ServiceSigned       M03ServiceContract[]     @relation("M03ServiceSigned")
  m03Terminated          M03ContractTermination[] @relation("M03Terminated")
  m03AuditEntries        M03AuditEntry[]

  m02CommitmentRevoked  M02SecurityCommitment[] @relation("M02CommitmentRevoked")
  m02VisitorApproved    M02VisitorLog[]         @relation("M02VisitorApproved")
  m02DisclosureApproved M02DisclosureApproval[] @relation("M02DisclosureApproved")
  m02IncidentDetected   M02SecurityIncident[]   @relation("M02IncidentDetected")
  m02IncidentAssessed   M02SecurityIncident[]   @relation("M02IncidentAssessed")
  m02IncidentClosed     M02SecurityIncident[]   @relation("M02IncidentClosed")
  m02AuditEntries       M02AuditEntry[]

  m04LogReported  M04ConditionLog[]  @relation("M04LogReported")
  m04PlanCreated  M04FieldWorkPlan[] @relation("M04PlanCreated")
  m04PlanApproved M04FieldWorkPlan[] @relation("M04PlanApproved")
  m04AuditEntries M04AuditEntry[]

  m16PlanCreated         M16AuditPlan[]            @relation("M16PlanCreated")
  m16PlanReviewed        M16AuditPlan[]            @relation("M16PlanReviewed")
  m16PlanApproved        M16AuditPlan[]            @relation("M16PlanApproved")
  m16ReportCreated       M16AuditReport[]          @relation("M16ReportCreated")
  m16QualRecognized      M16AuditorQualification[] @relation("M16QualRecognized")
  m16ProgramClosed       M16AuditProgram[]         @relation("M16ProgramClosed")
  m16FindingAcknowledged M16AuditFinding[]         @relation("M16FindingAcknowledged")
  m16DissentRecorded     M16ReportDissent[]        @relation("M16DissentRecorded")
  m16AuditEntries        M16AuditEntry[]

  m17PlanCreated     M17ReviewPlan[]              @relation("M17PlanCreated")
  m17PlanTpApproved  M17ReviewPlan[]              @relation("M17PlanTpApproved")
  m17PlanLdvApproved M17ReviewPlan[]              @relation("M17PlanLdvApproved")
  m17MinutesRecorded M17ReviewMinutes[]           @relation("M17MinutesRecorded")
  m17CapaCreated     M17CorrectiveActionRequest[] @relation("M17CapaCreated")
  m17AuditEntries    M17AuditEntry[]

  m12ComplaintCreated  M12Complaint[]            @relation("M12ComplaintCreated")
  m12ComplaintAssigned M12Complaint[]            @relation("M12ComplaintAssigned")
  m12FeedbackCreated   M12Feedback[]             @relation("M12FeedbackCreated")
  m12AuditEntries      M12AuditEntry[]
  m13NcwDetected       M13NonconformingWork[]    @relation("M13NcwDetected")
  m13NcwAssessed       M13NonconformingWork[]    @relation("M13NcwAssessed")
  m13CapAssigned       M13CorrectiveActionPlan[] @relation("M13CapAssigned")
  m13CapReviewed       M13CorrectiveActionPlan[] @relation("M13CapReviewed")
