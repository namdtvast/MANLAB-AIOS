model M03TrainingRecord {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "PT-2026-0001"

  trainingPlanId String
  employeeId     String

  // 6 điều kiện đồng thời — DacTa.md quy tắc 3
  c1AttendedAllContent Boolean @default(false)
  c2FollowedRules      Boolean @default(false)
  c3CanPerformWork     Boolean @default(false)
  c4RecordsComplete    Boolean @default(false)
  c5AssessmentPassed   Boolean @default(false)
  c6EvidenceSufficient Boolean @default(false)

  assessmentMethod String?
  evidence         String?
  result           M03TrainingResult?
  status           M03TrainingStatus  @default(DRAFT)
  reason           String?

  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingPlan M03TrainingPlan @relation(fields: [trainingPlanId], references: [id])
  employee     M03Employee     @relation(fields: [employeeId], references: [id])
  approvedBy   User?           @relation("M03TrainingApproved", fields: [approvedById], references: [id])

  m16Qualifications M16AuditorQualification[] @relation("M16QualEvidence") // bằng chứng năng lực M16 (Increment 13)

  m26Needs    M26KnowledgeNeed[] @relation("M26NeedTraining") // nhu cầu tri thức đáp ứng bằng đào tạo (quy tắc 8 DacTa M26)
