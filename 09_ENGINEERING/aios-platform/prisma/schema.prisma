// Vai trò nghiệp vụ theo TỪNG module — không dùng chung 1 enum vì mỗi module
// có bộ vai trò riêng (vd M10: NTH/LDP/LDV/QLCL/QTHT; M29: AI_VIEWER/AI_OPERATOR/
// AI_ADMIN/...— đã xác nhận khác nhau khi RECON api/model.mjs của 2 module gốc).
// role là String tự do theo vocabulary của module đó, KHÔNG phải PlatformRole
// (PlatformRole là quyền truy cập nền tảng nói chung: ADMIN/MEMBER/VIEWER).
model ModuleRoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  moduleCode String // vd "M10"
  role       String // vd "LDP" — theo đúng vocabulary gốc của module đó
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleCode, role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Module Registry (khung menu 38 module) ----------

enum ModuleStatus {
  ACTIVE // đã xây thật trong aios-platform (di trú từ 08_Source hoặc xây mới từ DacTa.md)
  COMING_SOON // chỉ có đặc tả, chưa xây trong nền tảng hợp nhất
}

model PlatformModule {
  id             String       @id @default(cuid())
  code           String       @unique // vd "M10"
  slug           String       @unique // vd "DamBaoKQ" — khớp tên thư mục 05_MODULE_LIBRARY
  name           String // tên hiển thị, lấy từ README.md của module
  mpCode         String? // MPxx tương ứng (quy ước: Mxx và MPxx cùng số)
  capabilityCode String? // CAP-xx liên quan, nếu xác định được từ manifest
  status         ModuleStatus @default(COMING_SOON)
  sourcePath     String // đường dẫn tương đối tới 05_MODULE_LIBRARY/Mxx_Slug trong repo
  order          Int          @unique // thứ tự menu phẳng, khớp số Mxx (giữ nguyên — vẫn dùng cho trang Bản đồ 38 module)

  // Nhóm menu (Increment 1 của _meta/specs/20260823-menu-phan-quyen-manlab).
  // Nguồn sự thật là khóa menu_group/menu_order trong 04_PROCESS_LIBRARY/MPxx/manifest.yaml
  // (schema manlab-aios/process@1.1) — seed.ts đọc lên, KHÔNG hardcode ở đây.
  // Nullable: module thiếu khai báo vẫn nạp được, seed in cảnh báo và xếp vào nhóm mặc định.
  menuGroup String? // vd "KY_THUAT"
  menuOrder Int? // thứ tự trong nhóm, theo dòng chảy nghiệp vụ

  // Căn cứ pháp lý hiển thị trên đầu mọi trang module (<CanCuBanner>).
  // Nguồn sự thật là khối document/forms trong 04_PROCESS_LIBRARY/MPxx/manifest.yaml
  // và links.yaml (procedure, form_files) — seed.ts đọc lên, KHÔNG hardcode ở đây.
  // Null nghĩa là MP đó chưa ban hành thủ tục: banner nói thẳng "chưa ban hành".
  docId          String? // vd "ETV.P01"
  docTitle       String? // tên đầy đủ của thủ tục
  purpose        String? // mục tiêu cô đọng của thủ tục (manifest.purpose) — MP chưa ban hành thủ tục thì null
  docStatus      String? // "issued" | "draft"
  docVersion     String? // lần ban hành, vd "03"
  issuedDate     DateTime? // ngày ban hành / hiệu lực
  procedurePath  String? // đường dẫn tương đối trong repo tới file thủ tục
  procedureOwner String? // chủ sở hữu quy trình (manifest.owner)
  standards      String[] // mã chuẩn áp dụng (manifest.standards), vd "ISO17025"
  isoClauses     String[] // điều khoản ISO viện dẫn, vd "ISO/IEC 17025:2017 §8.5"
  legalBasis     String[] // văn bản pháp luật viện dẫn
  forms          Json? // [{ code, title, path }] — biểu mẫu áp dụng

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- M10_DamBaoKQ — di trú từ 05_MODULE_LIBRARY/M10_DamBaoKQ/08_Source/api ----------
// Port 1:1 từ model.mjs (enum), rules.mjs (control rules R1–R8 — logic port sang
// src/lib/m10/rules.ts, KHÔNG lặp lại ở đây), store.mjs (thao tác dữ liệu).
// Nhãn tiếng Việt hiển thị (vd "Chờ soát xét") giữ ở tầng UI, DB dùng mã code ổn định.

enum M10RecordType {
  PT_ILC
  QC
  STABILITY
  PLAN // NO_TECH — không cần trường kỹ thuật (planId/procedureId/...)
  PUBLICATION // NO_TECH
}

enum M10Status {
  DRAFT
  PENDING_REVIEW
  RETURNED
  PENDING_APPROVAL
  REJECTED
  APPROVED
  PUBLISHED
  EXPIRED
  REVOKED
}

enum M10Result {
  PASS
  WARNING
  FAIL
}

enum M10PubStatus {
  PASS
  CONDITIONAL
  WARNING
  FAIL_BLOCKED
  EXPIRED
}

model M10Assessment {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement()) // dùng để sinh `code`, KHÔNG hiển thị trực tiếp
  code String @unique // vd "P10-2026-0001" — sinh 1 lần lúc tạo, ổn định

  recordType M10RecordType
  object     String
  status     M10Status     @default(DRAFT)
  result     M10Result?
  version    Int           @default(1)
  indicators Json // map chỉ tiêu kỹ thuật (vd {"z-score": 2.4, "En": 0.8}) — giữ tự do như bản gốc

  planId      String?
  procedureId String?
  personnelId String?
  criteriaId  String?
  rawData     Int     @default(0)
  evidence    Int     @default(0)

  capaId           String?
  pubStatus        M10PubStatus?
  sourceCertId     String?
  sourceSnapshotAt DateTime?
  releaseAllowed   Boolean       @default(false)
  expiresAt        DateTime?

  createdById  String
  reviewedById String?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User            @relation("M10Created", fields: [createdById], references: [id])
  reviewedBy   User?           @relation("M10Reviewed", fields: [reviewedById], references: [id])
  approvedBy   User?           @relation("M10Approved", fields: [approvedById], references: [id])
  auditEntries M10AuditEntry[]
}

model M10AuditEntry {
  id           String   @id @default(cuid())
  assessmentId String
  ts           DateTime @default(now())
  actorId      String
  role         String // vai trò M10 (NTH/LDP/LDV/...) của actor TẠI thời điểm hành động
  action       String
  reason       String?

  assessment M10Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  actor      User          @relation(fields: [actorId], references: [id])
}

// ---------- M21_CongBoNangLuc — di trú từ 05_MODULE_LIBRARY/M21_CongBoNangLuc/08_Source/index.html ----------
// Port 1:1 từ state machine `var TR`/`var ST` + gateCheck/lineGaps/recordGaps/hasGoodLine/doTransition
// của bản standalone gốc (xem 01_Requirement/_work/20260822-di-tru-m21/spec.md) sang
// src/lib/m21/rules.ts, KHÔNG lặp lại logic ở đây. Không dùng chung enum vai trò với M10
// (ModuleRoleAssignment.role tự do theo vocabulary từng module — xem ghi chú ở model đó).

enum M21RecordType {
  DL // Công bố năng lực Đo lường (Mẫu 01)
  QTMT // Thông báo hoạt động dịch vụ Quan trắc môi trường (Mẫu 9.01)
}

enum M21Status {
  CHUALAP
  DANGLAP
  SOATXET
  DNLDV
  PHENOIBO
  DAGUI
  YEUCAUBOSUNG
  TIEPNHAN
  CONGHIEU
  DIEUCHINH
  TAMDUNG
  HUYBO
  HETHIEU
}

enum M21LineResult {
  DAPUNG
  KHONG
  DIEUCHINH
}

model M21Record {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement()) // dùng để sinh `code`, KHÔNG hiển thị trực tiếp
  code String @unique // vd "CB-01/2026" (DL) / "TB-01/2026" (QTMT) — sinh 1 lần lúc tạo

  loai   M21RecordType
  lan    String        @default("01") // số hiệu phiên bản, tăng khi "Điều chỉnh" hoàn tất
  status M21Status     @default(CHUALAP)

  toChuc          String
  diaChi          String
  daiDien         String
  dienThoai       String @default("")
  email           String @default("")
  diaDiem         String @default("") // bắt buộc khi gửi soát xét nếu loai=DL — xem rules.ts
  coQuanTiepNhan  String
  coQuanChuQuan   String @default("")
  congNhanSo      String @default("")
  congNhanHieuLuc String @default("")

  kyso         Boolean   @default(false)
  kysoAt       DateTime?
  ngayGui      DateTime?
  maBienNhan   String?
  ngayTiepNhan DateTime?
  ngayCongKhai DateTime?

  phienBanCu    Json? // mảng snapshot {lan, ngayHieuLuc, luuLuc, lines} mỗi lần "Điều chỉnh" — xem BR ở spec.md
  baoCaoHangNam Json? // {ky,khoiLuong,thayDoi,qaqc,suCo,nguoiLap,ngayLap} — chỉ QTMT; UI nhập liệu ngoài phạm vi Increment 1

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User            @relation("M21Created", fields: [createdById], references: [id])
  lines        M21Line[]
  auditEntries M21AuditEntry[]
}

model M21Line {
  id       String @id @default(cuid())
  recordId String

  dichVu   String // "kiemdinh" (DL) | "quantrac" (QTMT) — set tự động theo loai hồ sơ cha
  ten      String @default("")
  linhVuc  String @default("")
  phamVi   String @default("")
  ccx      String @default("") // "Cấp/ĐCX/MPE/LOD"
  quyTrinh String @default("")
  nguoiTH  String @default("")
  ghiChu   String @default("")

  ketQua     M21LineResult @default(DAPUNG)
  lyDo       String        @default("") // bắt buộc khi ketQua != DAPUNG — BR10
  bangChung  String        @default("") // ghi chú bằng chứng dạng text — BR10 (KHÔNG lưu file thật, xem spec.md Quyết định phạm vi #2)
  bcFileName String        @default("") // tên file demo — placeholder, không lưu nội dung file

  linked     Boolean @default(false) // có chọn từ Danh mục PTĐ hay tự nhập tay
  catalogRef String  @default("") // tham chiếu tự do vào catalog.ts, KHÔNG FK (M05 chưa có backend thật)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  record M21Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model M21AuditEntry {
  id       String   @id @default(cuid())
  recordId String
  ts       DateTime @default(now())
  actorId  String
  role     String // vai trò M21 (NTH/LDP/LDV) của actor TẠI thời điểm hành động
  action   String
  reason   String?

  record M21Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor  User      @relation(fields: [actorId], references: [id])
}

// ---------- M29_AI — di trú từ 05_MODULE_LIBRARY/M29_AI/08_Source/api ----------
// Port 1:1 từ model.mjs (enum/hằng số) + rules.mjs (RBAC/vòng đời phê duyệt) sang
// src/lib/m29/{model,rules}.ts, KHÔNG lặp lại logic ở đây — xem
// 01_Requirement/_work/20260823-di-tru-m29/spec.md để đối chiếu nguyên văn.
// AIAgent.skillIds/toolIds là String[] (không phải bảng N-N riêng) — đúng cấu trúc gốc
// (JSON mảng id thô trong seed.mjs), không tự "chuẩn hoá" thêm bảng trung gian.

enum AIApprovalStatus {
  DRAFT
  PENDING_REVIEW
  RETURNED
  PENDING_APPROVAL
  REJECTED
  APPROVED
  ACTIVE // Hiệu lực — đã phê duyệt VÀ đã bật giám sát/kết nối (ETV.P35 Phụ lục II, trạng thái 7)
  ARCHIVED // Hết hiệu lực
  CANCELLED // Hủy — bỏ bản ghi trước khi phê duyệt (ETV.P35 Phụ lục II, trạng thái 9)
}

enum AIPromptStatus {
  DRAFT
  REVIEW
  APPROVED
  ACTIVE
  ARCHIVED
}

enum AIOpStatus {
  ACTIVE
  DISABLED
  DEPRECATED
  SUSPENDED
}

enum AIHealth {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum AIPermissionLevel {
  READ
  COMPUTE
  PROPOSE
  EXECUTE
}

enum AIGuardrailAction {
  BLOCK
  WARN
  REQUIRE_CONFIRMATION
  REQUIRE_APPROVAL
}

enum AIAStatus {
  NOT_ASSESSED
  DRAFT
  REVIEWED
  APPROVED
  REVIEW_REQUIRED
}

/// Ranh giới dữ liệu của một nền tảng mô hình — ETV.P29 §5.5.
///
/// §5.5 không hỏi MỘT câu mà hai câu lồng nhau: dữ liệu có rời hạ tầng của Viện không, và NẾU CÓ
/// thì nhà cung cấp có cam kết không dùng dữ liệu để huấn luyện lại không. Cam kết đó khác nhau
/// giữa các BẬC DỊCH VỤ của cùng một nhà cung cấp (bậc miễn phí thường không có), nên không suy
/// được từ tên nhà cung cấp, cũng không suy được từ `environment` — trường đó trả lời câu hỏi khác
/// (môi trường triển khai) và chưa từng được kiểm bởi bất kỳ nhánh logic nào.
///
/// Mặc định là trạng thái SIẾT NHẤT: khai thiếu thì bị siết, không được nới.
enum AIDataBoundary {
  NO_EXTERNAL_TRANSFER /// Dữ liệu không rời hạ tầng của Viện (mô hình tự vận hành) — trần Nội bộ
  EXTERNAL_WITH_COMMITMENT /// Rời hạ tầng, nhà cung cấp cam kết không huấn luyện lại, đã trích vào F29.02 — trần Nội bộ
  EXTERNAL_NO_COMMITMENT /// Rời hạ tầng, không có cam kết — chỉ được gửi mức Công khai
}

model AIPlatform {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  baseUrl     String?
  apiBaseUrl  String?
  environment String  @default("INTERNAL")

  // Ranh giới dữ liệu (ETV.P29 §5.5). KHÔNG suy từ `environment` ngay phía trên: hai trường trả
  // lời hai câu hỏi khác nhau, và `environment` mặc định "INTERNAL" — giá trị dễ dãi nhất — nên
  // dựng chốt an ninh lên nó là fail-OPEN.
  dataBoundary      AIDataBoundary   @default(EXTERNAL_NO_COMMITMENT)
  // Số hồ sơ chứng minh cam kết của nhà cung cấp (AIA/F29.02). BẮT BUỘC khi đặt
  // EXTERNAL_WITH_COMMITMENT — nới trần mà không có hồ sơ chống lưng thì enum này chỉ là ô tích.
  // Cưỡng chế ở tầng hành động (datRanhGioiDuLieu), không ràng buộc quan hệ ở lược đồ vì
  // AIImpactAssessment gắn với Agent chứ không gắn với Platform.
  dataBoundaryRef   String?
  health            AIHealth         @default(UNKNOWN)
  lastError         String?
  lastHealthCheckAt DateTime?
  owner             String           @default("")
  adapterType       String // "ManlabPlatformAdapter" | "PlaceholderPlatformAdapter"
  approvalStatus    AIApprovalStatus @default(DRAFT)
  approvedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools     AITool[]
  agents    AIAgent[]
  incidents AIIncident[]
  providers AIProvider[]
}

model AIProvider {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  status     AIOpStatus @default(ACTIVE)
  // Nền tảng phơi API của nhà cung cấp này. CÓ THỂ RỖNG một cách có chủ ý: dịch vụ mô hình ngoài
  // Viện (Anthropic, Gemini) chạy được mà không cần bản ghi nền tảng riêng, nên ép NOT NULL sẽ
  // buộc nạp lại dữ liệu cũ. Bắt buộc điền với nhà cung cấp TỰ VẬN HÀNH (máy chủ GPU nội bộ) —
  // đó là nơi duy nhất giữ apiBaseUrl và trạng thái kiểm tra sức khoẻ (ETV.GAI 01 §3.6).
  // KHÔNG nhân đôi baseUrl sang đây: một endpoint chỉ có một nguồn sự thật là AIPlatform.
  platformId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models   AIModel[]
  // Restrict, không SetNull: xoá nền tảng mà âm thầm gỡ liên kết của Provider là mất dấu vết
  // đăng ký. Chặn xoá để buộc gỡ Provider trước — thống nhất với các quan hệ khác trong M29.
  platform AIPlatform? @relation(fields: [platformId], references: [id], onDelete: Restrict)
}

model AIModel {
  id              String     @id @default(cuid())
  providerId      String
  modelId         String // vd "gemini-2.5-flash" — id thật của model tại provider, khác PK
  displayName     String
  purpose         String     @default("")
  status          AIOpStatus @default(ACTIVE)
  temperature     Float?
  maxTokens       Int?
  costPer1kTokens Float      @default(0)
  version         Int        @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider AIProvider  @relation(fields: [providerId], references: [id])
  agents   AIAgent[]
  requests AIRequest[]
}

model AISkill {
  id            String     @id @default(cuid())
  code          String     @unique
  name          String
  platformScope String     @default("")
  version       Int        @default(1)
  status        AIOpStatus @default(ACTIVE)
  riskLevel     String     @default("LOW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AITool {
  id                  String            @id @default(cuid())
  platformId          String
  code                String            @unique
  name                String
  endpoint            String
  httpMethod          String            @default("GET")
  inputSchema         Json              @default("{}")
  outputSchema        Json              @default("{}")
  permissionLevel     AIPermissionLevel
  riskLevel           String            @default("LOW")
  requireConfirmation Boolean           @default(false)
  requireApproval     Boolean           @default(false)
  status              AIOpStatus        @default(ACTIVE)
  version             Int               @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platform  AIPlatform   @relation(fields: [platformId], references: [id])
  toolCalls AIToolCall[]
}

model AIAgent {
  id                    String     @id @default(cuid())
  platformId            String
  code                  String     @unique
  name                  String
  purpose               String     @default("")
  modelId               String?
  activePromptVersionId String?
  status                AIOpStatus @default(ACTIVE)
  riskLevel             String     @default("MEDIUM")
  owner                 String     @default("")
  version               Int        @default(1)
  skillIds              String[]   @default([])
  toolIds               String[]   @default([])
  // Vì sao Agent bị Tạm dừng: "AIA_OVERDUE" (sweep AIA quá hạn — ETV.P29 5.2.3) hoặc
  // "INCIDENT:<mã phiếu>" (khống chế sự cố Nghiêm trọng — ETV.P29 5.7.3). Phân biệt hai nguyên
  // nhân này để chỉ tự phục hồi đúng nhánh AIA, xem rules/actions.
  suspendedReason       String?
  suspendedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platform         AIPlatform               @relation(fields: [platformId], references: [id])
  model            AIModel?                 @relation(fields: [modelId], references: [id])
  prompts          AIPrompt[]
  aia              AIImpactAssessment[]
  evaluationSuites AIEvaluationSuite[]
  requests         AIRequest[]
  incidents        AIIncident[]
  sightings        AIUnregisteredSighting[]
}

model AIPrompt {
  id      String @id @default(cuid())
  code    String @unique
  agentId String

  createdAt DateTime @default(now())

  agent    AIAgent           @relation(fields: [agentId], references: [id])
  versions AIPromptVersion[]
}

model AIPromptVersion {
  id            String         @id @default(cuid())
  promptId      String
  content       String
  status        AIPromptStatus @default(DRAFT)
  createdBy     String?
  approvedBy    String?
  effectiveFrom DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prompt   AIPrompt    @relation(fields: [promptId], references: [id])
  requests AIRequest[]
}

// scope/scopeRef đa hình (SYSTEM/PLATFORM/AGENT/SKILL/TOOL/WORKFLOW) — giữ String tự do như bản
// gốc, KHÔNG FK (một trường không thể trỏ nhiều bảng khác nhau trong Prisma).
model AIGuardrail {
  id             String            @id @default(cuid())
  code           String            @unique
  description    String
  scope          String
  scopeRef       String?
  severity       String            @default("MEDIUM")
  action         AIGuardrailAction
  approvalStatus AIApprovalStatus  @default(DRAFT)
  approvedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIPolicy {
  id             String           @id @default(cuid())
  name           String
  version        Int              @default(1)
  owner          String           @default("")
  approver       String           @default("")
  effectiveDate  DateTime?
  approvalStatus AIApprovalStatus @default(DRAFT)
  approvedBy     String?
  reference      String           @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIImpactAssessment {
  id             String    @id @default(cuid())
  code           String    @unique // vd "AIA-2026-001"
  agentId        String
  purpose        String
  dataUsed       String    @default("")
  affectedUsers  String    @default("")
  risk           String    @default("LOW")
  humanOversight String    @default("")
  controls       String    @default("")
  residualRisk   String    @default("LOW")
  status         AIAStatus @default(NOT_ASSESSED)
  reviewDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent AIAgent @relation(fields: [agentId], references: [id])
}

model AIEvaluationSuite {
  id      String @id @default(cuid())
  name    String
  agentId String

  createdAt DateTime @default(now())

  agent AIAgent            @relation(fields: [agentId], references: [id])
  cases AIEvaluationCase[]
  runs  AIEvaluationRun[]
}

model AIEvaluationCase {
  id       String @id @default(cuid())
  suiteId  String
  input    Json
  expected String

  suite AIEvaluationSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
}

model AIEvaluationRun {
  id           String @id @default(cuid())
  suiteId      String
  agentVersion Int    @default(1)
  passCount    Int    @default(0)
  failCount    Int    @default(0)
  status       String // PASS/FAIL/NO_CASES

  createdAt DateTime @default(now())

  suite AIEvaluationSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
}

model AIRequest {
  id               String  @id @default(cuid()) // = traceId
  platformId       String?
  agentId          String?
  modelId          String?
  promptVersionId  String?
  userRef          String
  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  latencyMs        Int     @default(0)
  guardrailResult  String  @default("PASS")
  evaluationResult String?

  createdAt DateTime @default(now())

  agent         AIAgent?         @relation(fields: [agentId], references: [id])
  model         AIModel?         @relation(fields: [modelId], references: [id])
  promptVersion AIPromptVersion? @relation(fields: [promptVersionId], references: [id])
  toolCalls     AIToolCall[]
}

model AIToolCall {
  id        String  @id @default(cuid())
  requestId String
  toolId    String
  input     Json
  output    Json?
  status    String // OK/ERROR
  latencyMs Int     @default(0)
  errorCode String?

  request AIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tool    AITool    @relation(fields: [toolId], references: [id])
}

// Chỉ lưu maskedValue — KHÔNG lưu giá trị thật trong Postgres dev dùng chung (spec.md Quyết
// định phạm vi #3). Khác bản gốc (lưu thật ở file tách riêng secrets.local.json).
model AISecret {
  id          String    @id @default(cuid())
  platformId  String
  name        String
  maskedValue String
  status      String    @default("ACTIVE")
  lastRotated DateTime  @default(now())
  lastUsed    DateTime?

  createdAt DateTime @default(now())
}

model AIAuditLog {
  id         String   @id @default(cuid())
  // actorId để trống khi hành động do hệ thống thực hiện theo lịch (sweep AIA quá hạn) —
  // khi đó actorLabel = "SYSTEM". Hệ thống chỉ PHÁT HIỆN theo lịch, không tự kết luận nội dung
  // đánh giá (DacTa quy tắc 11, ETV.P29 5.2.3).
  actorId    String?
  actorLabel String   @default("")
  role       String // vai trò M29 (AI_VIEWER/.../SUPER_ADMIN) của actor TẠI thời điểm hành động
  entityType String
  entityId   String
  field      String?
  before     Json?
  after      Json?
  reason     String?
  at         DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}

// ---------- M29 Increment 4 — giám sát AIA quá hạn, sự cố AI, AI chưa đăng ký ----------
// Xây theo ETV.P29 (ban hành 24/8/2026) mục 5.1.7, 5.2.3, 5.7, 6.3 — xem
// 05_MODULE_LIBRARY/M29_AI/01_Requirement/_work/20260824-m29-giam-sat-su-co/spec.md.

enum AIIncidentSeverity {
  SEVERE // Nghiêm trọng — ETV.P29 5.7.2
  SIGNIFICANT // Đáng kể
  MINOR // Nhẹ
}

enum AIIncidentKind {
  WRONG_OUTPUT
  DATA_LEAK
  PROMPT_INJECTION
  PERMISSION_BREACH
  BIAS
  SERVICE_DISRUPTION
  UNREGISTERED_AI
  OTHER
}

enum AIIncidentStatus {
  NEW
  IN_PROGRESS
  PENDING_CONFIRMATION
  CLOSED
  CANCELLED
}

enum AIUnregisteredStatus {
  OPEN
  REGISTERING
  REGISTERED
  DISCONTINUED
}

// Phiếu sự cố trí tuệ nhân tạo — biểu mẫu ETV.P.F29.04.
model AIIncident {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // "SCAI-YYYY-NNNN"

  severity AIIncidentSeverity
  kind     AIIncidentKind

  agentId    String?
  platformId String?
  traceId    String? // mã AIRequest liên quan (nhật ký suy luận)

  occurredAt   DateTime @default(now())
  detectedAt   DateTime @default(now())
  detectedById String

  description       String
  containmentAction String @default("")

  // Ảnh hưởng kết quả/chứng chỉ ĐÃ PHÁT HÀNH: phần mềm không tự kết luận về hiệu lực kết quả,
  // chỉ buộc khai báo mã hồ sơ đã xử lý theo ETV.MP10/MP11 (ETV.P29 5.7.3 điểm 4).
  affectsIssuedResult  Boolean @default(false)
  issuedResultRef      String?
  sensitiveDataExposed Boolean @default(false)
  f28Ref               String? // số phiếu ETV.P.F28.03 (xử lý đồng thời theo ETV.MP28)
  capRef               String? // mã KPH theo ETV.MP13

  assessedById String?
  closedById   String?
  closureNote  String?
  cancelReason String?

  status AIIncidentStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent      AIAgent?    @relation(fields: [agentId], references: [id])
  platform   AIPlatform? @relation(fields: [platformId], references: [id])
  detectedBy User        @relation("AIIncidentDetected", fields: [detectedById], references: [id])
  assessedBy User?       @relation("AIIncidentAssessed", fields: [assessedById], references: [id])
  closedBy   User?       @relation("AIIncidentClosed", fields: [closedById], references: [id])

  sightings AIUnregisteredSighting[]
}

// Hệ thống AI phát hiện đang dùng mà chưa đăng ký — ETV.P29 5.1.7, phần 3 biểu mẫu F29.01.
model AIUnregisteredSighting {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // "UAI-YYYY-NNN"

  name         String
  usedBy       String
  detectedAt   DateTime @default(now())
  detectedById String

  dataExposed   String  @default("")
  sensitiveData Boolean @default(false) // dữ liệu Hạn chế/Mật hoặc dữ liệu cá nhân
  incidentId    String? // bắt buộc khi sensitiveData = true mới đóng được

  plannedAction String   @default("")
  dueDate       DateTime // mặc định detectedAt + 15 ngày (ETV.P29 5.1.7)

  registeredAgentId String? // bắt buộc khi đóng bằng REGISTERED
  closeReason       String? // bắt buộc khi DISCONTINUED

  status AIUnregisteredStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detectedBy      User        @relation("AIUnregisteredDetected", fields: [detectedById], references: [id])
  incident        AIIncident? @relation(fields: [incidentId], references: [id])
  registeredAgent AIAgent?    @relation(fields: [registeredAgentId], references: [id])
}

// ---------- M29 Copilot tra cứu (chỉ-đọc) ----------
// Đặc tả: 05_MODULE_LIBRARY/M29_AI/01_Requirement/_work/20260825-copilot-tra-cuu/{spec.md,plan.md,q1-anh-xa-muc-bao-mat.md}.
// Copilot KHÔNG có bảng cấu hình riêng — nó là một `AIAgent` trong control plane M29, nên
// prompt/AIA/guardrail/policy/trace đều nằm ở các bảng AI* sẵn có (spec §1, Quyết định #4).
// Ba bảng dưới đây chỉ giữ phần control plane không có chỗ chứa: chỉ mục tri thức và hội thoại.

// Một đoạn (chunk) tài liệu đã được phép nạp chỉ mục. Chỉ chứa tài liệu mức Công khai/Nội bộ đã
// phê duyệt — ETV.P29 §5.5 + ETV.P26 §5.5; quy tắc nạp và danh sách lớp tài liệu ở
// scripts/nap-chi-muc-copilot.ts. Bảng này KHÔNG bao giờ được chứa mức Hạn chế/Mật (E1, AC-11).
model CopilotDocChunk {
  id            String @id @default(cuid())
  path          String // đường dẫn tương đối tính từ gốc repo, dùng làm trích dẫn
  title         String // tiêu đề tài liệu
  heading       String @default("") // tiêu đề mục chứa đoạn này
  docClass      String // mã lớp tài liệu theo q1-anh-xa-muc-bao-mat.md §3
  securityLevel String // "Cong-khai" | "Noi-bo" — giá trị khác không được phép tồn tại ở đây
  approvalRef   String @default("") // trạng thái phê duyệt của nguồn tại thời điểm nạp
  ordinal       Int    @default(0)
  content       String
  // Hai cột tìm kiếm tách riêng để đánh TRỌNG SỐ khác nhau trong tsvector: khớp ở tiêu đề tài
  // liệu/tiêu đề mục (hạng A) đáng giá hơn hẳn khớp trong thân bài (hạng D). Không tách thì mọi
  // truy vấn OR đều bị tài liệu dài nuốt mất.
  searchTitle   String @default("") // tiêu đề + tiêu đề mục, đã bỏ dấu + hạ chữ thường
  searchText    String // nội dung đoạn, đã bỏ dấu + hạ chữ thường

  // Vector tìm kiếm toàn văn. Prisma không đọc được kiểu tsvector nên khai Unsupported và cập
  // nhật bằng raw SQL trong script nạp chỉ mục — không dùng cột GENERATED để tránh lệch schema.
  tsv Unsupported("tsvector")?

  indexedAt DateTime @default(now())

  @@index([path])
  @@index([securityLevel])
  @@index([tsv], type: Gin)
}

model CopilotThread {
  id            String  @id @default(cuid())
  userId        String
  moduleContext String? // mã module người dùng đang mở khi bắt đầu hội thoại (vd "M13")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  messages CopilotMessage[]

  @@index([userId])
}

// Mỗi lượt trả lời trỏ về đúng một AIRequest (requestId) — kể cả lượt bị guardrail chặn hoặc lượt
// lỗi — để không có đường vòng nào thoát khỏi sổ trace của M29 (spec §7, AC-03).
model CopilotMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String // "user" | "assistant"
  content   String
  citations Json     @default("[]") // [{path, title, heading}]
  requestId String?
  createdAt DateTime @default(now())

  thread CopilotThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// ---------- M01_RuiRo — xây mới từ 05_MODULE_LIBRARY/M01_RuiRo/01_Requirement/DacTa.md ----------
// Không có 08_Source nguyên mẫu (khác M10/M21/M29 là di trú) — logic state machine port từ
// ETV.P01_RuiRoCoHoi.md (Đã phê duyệt, lần 03) sang src/lib/m01/rules.ts, xem
// 01_Requirement/_work/20260823-xay-moi-m01/spec.md để đối chiếu "Quyết định phạm vi" #1-#4.

enum M01Source {
  DANH_GIA_NOI_BO
  XEM_XET_LANH_DAO
  DE_XUAT_NHAN_VIEN
  PHAN_NAN
  DANH_GIA_BEN_NGOAI
  TNTT_SSLP // Đảm bảo giá trị kết quả bằng TNTT/SSLP — nguồn tham chiếu M10
  KHAC
}

enum M01OppSource {
  DANH_GIA_NOI_BO
  DE_XUAT_NHAN_VIEN
  PHAN_HOI_KHACH_HANG
  KHAC
}

enum M01RiskLevel {
  THAP // R 1-3
  TRUNGBINH // R 4-8
  CAO // R 9-15
  RATCAO // R 16-25
}

enum M01Status {
  DRAFT
  PENDING_REVIEW
  PENDING_LEADER_APPROVAL // chỉ Rủi ro mức RATCAO đi qua state này (LĐV quyết định — spec.md Quyết định phạm vi #2)
  IN_PROGRESS
  DONE
}

enum M01VerifyResult {
  DAT
  CHUA_DAT
}

enum M01ItemType {
  RISK
  OPPORTUNITY
}

model M01RiskItem {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement()) // dùng để sinh `code`, KHÔNG hiển thị trực tiếp
  code String @unique // vd "RR-2026-0001" — sinh 1 lần lúc tạo, ổn định

  title       String
  description String
  source      M01Source

  cause          String?
  controlMeasure String?

  severity    Int? // S, 1-5
  possibility Int? // P, 1-5
  riskScore   Int? // R = S x P — server tự tính, KHÔNG nhận trực tiếp từ client
  riskLevel   M01RiskLevel?

  status M01Status @default(DRAFT)

  assigneeId String?
  dueDate    DateTime?

  evidence     String?
  verifyResult M01VerifyResult?
  verifiedById String?

  createdById  String
  reviewedById String?
  approvedById String? // chỉ set khi đi qua nhánh LĐV (RATCAO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy  User  @relation("M01RiskCreated", fields: [createdById], references: [id])
  reviewedBy User? @relation("M01RiskReviewed", fields: [reviewedById], references: [id])
  approvedBy User? @relation("M01RiskApproved", fields: [approvedById], references: [id])
