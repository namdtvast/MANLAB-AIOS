}

// ---------- M13_KhacPhuc — xây mới từ 05_MODULE_LIBRARY/M13_KhacPhuc/01_Requirement/DacTa.md ----------
// Không có 08_Source nguyên mẫu (giống M01/M02/M03/M04/M16/M17/M12) — logic port từ
// ETV.P13_KhacPhuc.md (Đã phê duyệt, lần 03), xem
// 01_Requirement/_work/20260823-xay-moi-m13/spec.md để đối chiếu "Quyết định phạm vi".
// M13 là điểm hội tụ CAPA của hệ thống (M05/M10/M12 dẫn về). Gate chính: mức Nặng không được
// tiếp tục/đóng công việc cho tới khi QLCL thẩm xét phương án khắc phục ĐẠT — không tự mở khóa.

enum M13SourceType {
  TU_PHAT_HIEN
  KHIEU_NAI // ← M12
  IC_VUOT_GIOI_HAN // ← M05
  DANH_GIA_NOI_BO // ← M16 (phát hiện Không phù hợp khi đánh giá nội bộ, Increment 13)
  KHAC
}

enum M13Severity {
  NHE
  NANG
}

enum M13NcwStatus {
  GHI_NHAN
  DANG_THEO_DOI // mức Nhẹ — tiếp tục việc nhưng theo dõi chặt (quy tắc 3)
  DANG_KHAC_PHUC // mức Nặng — đã dừng hẳn việc (quy tắc 4)
  DA_KHAC_PHUC
}

enum M13CapStatus {
  DANG_THUC_HIEN
  CHO_THAM_XET
  DAT
  KHONG_DAT
}

enum M13ItemType {
  NCW
  CAP
}

model M13NonconformingWork {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // vd "KPH-2026-0001"

  sourceType    M13SourceType
  sourceRef     String? // tham chiếu tự do → M12 (mã khiếu nại) / M05, không FK chéo module
  description   String
  severity      M13Severity? // null = chưa đánh giá (quy tắc 2: đánh giá thủ công, không tự động)
  severityBasis String?
  assessedById  String?
  status        M13NcwStatus  @default(GHI_NHAN)
  emergencyStop Boolean       @default(false) // quy tắc 1: dừng ngay khi phát hiện, báo cáo sau
  stoppedWork   Boolean       @default(false) // quy tắc 4: bắt buộc true khi severity = NANG

  detectedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detectedBy User  @relation("M13NcwDetected", fields: [detectedById], references: [id])
  assessedBy User? @relation("M13NcwAssessed", fields: [assessedById], references: [id])

  plan            M13CorrectiveActionPlan?
  revokedReports  M13RevokedReport[]
  monitoringNotes M13MonitoringNote[]

  m16Finding M16AuditFinding? @relation("M16FindingNcw") // hồ sơ KPH sinh từ phát hiện M16 (Increment 13)

  m26Lessons M26LessonLearned[] // bài học kinh nghiệm kết tinh từ KPH này (quy tắc 6 DacTa M26)
}

model M13CorrectiveActionPlan {
  id    String @id @default(cuid())
  ncwId String @unique // 1-1 với NCW — xem "Quyết định phạm vi" #1 trong spec.md

  rootCause    String
  actionPlan   String
  assignedToId String
  status       M13CapStatus @default(DANG_THUC_HIEN)
  completedAt  DateTime?

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  replacementReportRef    String? // báo cáo thay thế báo cáo đã thu hồi
  replacementApprovedById String? // quy tắc 6: chỉ LĐV
  replacementApprovedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ncw                   M13NonconformingWork @relation(fields: [ncwId], references: [id])
  assignedTo            User                 @relation("M13CapAssigned", fields: [assignedToId], references: [id])
  reviewedBy            User?                @relation("M13CapReviewed", fields: [reviewedById], references: [id])
  replacementApprovedBy User?                @relation("M13CapReplacementApproved", fields: [replacementApprovedById], references: [id])
}

model M13RevokedReport {
  id        String   @id @default(cuid())
  ncwId     String
  reportRef String // tham chiếu tự do → M11 (báo cáo/GCN bị thu hồi)
  note      String?
  createdAt DateTime @default(now())

  ncw M13NonconformingWork @relation(fields: [ncwId], references: [id])
}

model M13MonitoringNote {
  id        String   @id @default(cuid())
  ncwId     String
  note      String // quy tắc 3: ghi chép đầy đủ diễn biến với mức Nhẹ
  authorId  String
  createdAt DateTime @default(now())

  ncw    M13NonconformingWork @relation(fields: [ncwId], references: [id])
  author User                 @relation(fields: [authorId], references: [id])
}

model M13AuditEntry {
  id       String      @id @default(cuid())
  itemType M13ItemType
  itemId   String
  ts       DateTime    @default(now())
  actorId  String
  role     String
  action   String
  reason   String?

  actor User @relation(fields: [actorId], references: [id])
}

// ---------- M14_TaiLieu — xây mới từ 05_MODULE_LIBRARY/M14_TaiLieu ----------
// Khác các module trước: M14 đã có sẵn đặc tả 02_API/API.md, 03_Database/DataModel.md và
// 07_Workflow/StateMachine.md — schema này bám theo, KHÔNG định nghĩa lại. Metadata theo đúng
// bảng ETV.P14 §6.3 (quy định gốc duy nhất). Trạng thái dùng đúng 7 giá trị của StateMachine.md.
// Gate ISO 42001: AI Agent chỉ ghi M14AiSuggestion, không bao giờ đổi status (ETV.P14 §6.9).

enum M14DocType {
  SO_TAY
  THU_TUC
  QUY_TRINH
  HUONG_DAN
  BIEU_MAU
  QUYET_DINH
  CONG_VAN
  THONG_BAO
  BIEN_BAN
  BAO_CAO
  GIAY_CHUNG_NHAN
  VAN_BAN_BEN_NGOAI
}

enum M14DocStatus {
  NHAP
  CHO_SOAT_XET
  KHONG_SOAT_XET
  CHO_PHE_DUYET
  KHONG_PHE_DUYET
  DA_PHE_DUYET
  HET_HIEU_LUC_HUY
}

enum M14KnowledgeCategory {
  NOI_BO
  CONG_KHAI
  MAT
}

// §6.11: hai hành vi khác nhau cùng đích "Hết hiệu lực/Hủy" — thanh lý (LĐP) vs hủy bỏ (LĐV).
enum M14DisposalType {
  THANH_LY
  HUY_BO
}

enum M14ItemType {
  DOCUMENT
  SUGGESTION
}

model M14Document {
  id   String @id @default(cuid())
  seq  Int    @default(autoincrement())
  code String @unique // mã theo ETV.P14 §6.2, duy nhất toàn hệ thống

  title       String
  docType     M14DocType
  owner       String
  department  String
  processCode String? // → MPxx (04_PROCESS_LIBRARY)

  effectiveDate DateTime?
  revision      String?

  keywords         String[]
  relatedDocuments String[]
  isoClause        String[]
  legalBasis       String[]
  aiTags           String[]

  knowledgeCategory M14KnowledgeCategory?
  permissionGroup   String? // → ETV.P.F 14.06 (biểu mẫu chưa số hóa — lưu chuỗi tham chiếu)
  retention         String? // → ETV.P.F 14.06
  digitalSignature  String?
  sourceOrg         String? // nơi phát hành/tiếp nhận

  status       M14DocStatus     @default(NHAP)
  disposalType M14DisposalType?
  reviewNote   String?

  publishedAt      DateTime?
  publishedById    String?
  distributionNote String? // ETV.P.F 14.04 — phiếu giao nhận

  supersedesId String? @unique // cặp nghịch đảo, hệ thống tự đồng bộ 2 chiều (quy tắc 6)

  createdById  String
  reviewedById String?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User  @relation("M14DocCreated", fields: [createdById], references: [id])
  reviewedBy  User? @relation("M14DocReviewed", fields: [reviewedById], references: [id])
  approvedBy  User? @relation("M14DocApproved", fields: [approvedById], references: [id])
  publishedBy User? @relation("M14DocPublished", fields: [publishedById], references: [id])

  supersedes   M14Document? @relation("M14Supersedes", fields: [supersedesId], references: [id])
  supersededBy M14Document? @relation("M14Supersedes")

  suggestions M14AiSuggestion[]
  m26Items    M26KnowledgeItem[] // mục tri thức trỏ tới tài liệu kiểm soát này (quy tắc 2 DacTa M26)
}

// ETV.P14 §6.9: AI chỉ gợi ý và cảnh báo — mọi gợi ý nằm ở bảng này, phải có người có thẩm quyền
// bấm "Áp dụng" mới ghi vào M14Document.
model M14AiSuggestion {
  id         String @id @default(cuid())
  documentId String

  field          String // tên trường được gợi ý (vd "isoClause")
  suggestedValue String
  rationale      String?

  createdById String
  createdAt   DateTime @default(now())

  appliedById String?
  appliedAt   DateTime?

  document  M14Document @relation(fields: [documentId], references: [id])
  createdBy User        @relation("M14SuggestionCreated", fields: [createdById], references: [id])
  appliedBy User?       @relation("M14SuggestionApplied", fields: [appliedById], references: [id])
}

model M14AuditEntry {
  id       String      @id @default(cuid())
  itemType M14ItemType
  itemId   String
  ts       DateTime    @default(now())
  actorId  String
  role     String
  action   String
  reason   String?

  actor User @relation(fields: [actorId], references: [id])
}

// ---------- M25_BoiCanh — xây mới từ 05_MODULE_LIBRARY/M25_BoiCanh/01_Requirement/DacTa.md ----------
