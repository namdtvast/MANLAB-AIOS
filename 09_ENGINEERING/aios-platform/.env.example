# Mẫu biến môi trường của aios-platform. Sao chép thành `.env` và điền giá trị thật.
# `.env` đã nằm trong .gitignore — KHÔNG commit giá trị thật.

# --- Bắt buộc ---
DATABASE_URL="postgresql://user:password@localhost:5432/aios_platform_dev"
AUTH_SECRET=""            # sinh bằng: npx auth secret
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Mật khẩu tài khoản demo do prisma/seed.ts dùng cho tài khoản TẠO MỚI.
# Bỏ trống thì seed sinh ngẫu nhiên và in ra một lần.
SEED_DEMO_PASSWORD=""

# --- Copilot tra cứu (M29) ---
# Khóa API của dịch vụ mô hình. Bảng AISecret CỐ Ý chỉ lưu maskedValue, giá trị thật chỉ nằm ở
# đây (đặc tả _meta/specs/20260825-ai-copilot-tra-cuu/spec.md §9). Không có khóa thì khay Copilot
# vẫn hiện nhưng mọi lượt hỏi trả lỗi NO_API_KEY — trang đang mở không bị ảnh hưởng.
ANTHROPIC_API_KEY=""

# Hạn mức chi phí tháng (USD) cho Copilot. Tham số vận hành, do LĐV ấn định và khai trong
# ETV.P.F29.01 — đổi hạn mức KHÔNG kéo theo ban hành lại thủ tục. Bỏ trống = không chặn theo
# chi phí (AIA Gate và guardrail vẫn còn hiệu lực).
COPILOT_MONTHLY_BUDGET_USD=""

# Cần gạt tắt toàn cục Copilot, không cần deploy lại schema. Đặt "false" để ẩn khay ngay lập tức.
# Cách tắt theo đúng quy trình quản trị là chuyển AIAgent AGENT_COPILOT_TRACUU sang SUSPENDED
# trong M29 — biến này là đường tắt kỹ thuật cho sự cố.
COPILOT_ENABLED="true"

# Cổng tài liệu dùng để mở file gốc trong repo từ trích dẫn của Copilot và banner Căn cứ.
NEXT_PUBLIC_DOCS_PORTAL_URL="https://namdtvast.github.io/MANLAB-AIOS/"
